---
import {
	KNOWLEDGE_CATEGORIES,
	KNOWLEDGE_SECTIONS,
} from '../content/knowledge-taxonomy';
import type { KnowledgeNote } from '../lib/knowledge';

type Props = {
	notes: KnowledgeNote[];
	activeId?: string;
};

const { notes, activeId } = Astro.props;
---

<aside class="knowledge-sidebar">
	<details class="knowledge-nav-details" open>
		<summary>
			<span>Knowledge navigation</span>
			<strong>{notes.length} {notes.length === 1 ? 'note' : 'notes'}</strong>
		</summary>
		<nav aria-label="Knowledge base">
			<a
				class:list={['knowledge-overview-link', { active: !activeId }]}
				href="/knowledge"
			>
				<strong>Overview</strong>
			</a>

			{
				KNOWLEDGE_CATEGORIES.map((category) => {
					const categoryNotes = notes.filter(
						(note) => note.data.category === category.id,
					);
					const directNotes = categoryNotes.filter(
						(note) => !note.data.section,
					);
					const sections = KNOWLEDGE_SECTIONS.filter(
						(section) => section.category === category.id,
					);

					return (
						<section class="knowledge-domain">
							<div class="knowledge-domain-heading">
								<h2>{category.label}</h2>
							</div>
							{directNotes.length > 0 && (
								<ul>
									{directNotes.map((note) => (
										<li>
											<a
												class:list={{ active: note.id === activeId }}
												href={`/knowledge/${note.id}/`}
												aria-current={note.id === activeId ? 'page' : undefined}
											>
												{note.data.title}
											</a>
										</li>
									))}
								</ul>
							)}
							{sections.map((section) => {
								const sectionNotes = categoryNotes.filter(
									(note) => note.data.section === section.id,
								);
								const landing = sectionNotes.find(
									(note) => note.data.sectionLanding,
								);
								const lessons = sectionNotes.filter(
									(note) => !note.data.sectionLanding,
								);

								if (sectionNotes.length === 0) return null;

								return (
									<div class="knowledge-subsection">
										{landing ? (
											<a
												class:list={[
													'knowledge-subsection-link',
													{ active: landing.id === activeId },
												]}
												href={`/knowledge/${landing.id}/`}
												aria-current={
													landing.id === activeId ? 'page' : undefined
												}
											>
												<strong>{section.label}</strong>
											</a>
										) : (
											<p class="knowledge-subsection-link">
												<strong>{section.label}</strong>
											</p>
										)}
										<ul class="knowledge-subsection-list">
											{lessons.map((note) => (
												<li>
													<a
														class:list={{ active: note.id === activeId }}
														href={`/knowledge/${note.id}/`}
														aria-current={
															note.id === activeId ? 'page' : undefined
														}
													>
														{note.data.title}
													</a>
												</li>
											))}
										</ul>
									</div>
								);
							})}
							{categoryNotes.length === 0 && (
								<p class="knowledge-empty-category">Notes coming soon</p>
							)}
						</section>
					);
				})
			}
		</nav>
	</details>
</aside>

<style>
	.knowledge-sidebar {
		position: sticky;
		top: 7.5rem;
		max-height: calc(100vh - 9rem);
		padding-right: 2rem;
		border-right: 1px solid var(--border);
		overflow-y: auto;
		scrollbar-width: thin;
	}

	.knowledge-nav-details > summary {
		display: none;
	}

	.knowledge-overview-link {
		display: block;
		width: 100%;
		margin-bottom: 2rem;
		padding: 0.75rem;
		border: 1px solid var(--text-faint);
		border-radius: var(--panel-radius);
		box-shadow: 2px 2px 0 var(--accent-faint);
		color: var(--text-secondary);
	}

	.knowledge-overview-link strong {
		font-size: 0.82rem;
		font-weight: 500;
	}

	.knowledge-overview-link:hover,
	.knowledge-overview-link.active {
		border-color: var(--accent);
		background: var(--accent-faint);
		color: var(--heading);
	}

	.knowledge-domain {
		margin-bottom: 2rem;
	}

	.knowledge-domain-heading {
		margin-bottom: 0.65rem;
		padding: 0 0.75rem;
	}

	.knowledge-domain-heading h2 {
		color: var(--heading);
		font-family: var(--font-mono);
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.07em;
		line-height: 1.45;
		text-transform: uppercase;
	}

	.knowledge-domain ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.knowledge-domain li + li {
		margin-top: 0.15rem;
	}

	.knowledge-domain li a {
		display: block;
		width: 100%;
		padding: 0.52rem 0.75rem;
		border-radius: 5px;
		color: var(--text-muted);
		font-size: 0.78rem;
		line-height: 1.45;
	}

	.knowledge-domain li a:hover,
	.knowledge-domain li a.active {
		background: var(--accent-faint);
		color: var(--heading);
	}

	.knowledge-domain li a.active {
		box-shadow: inset 3px 0 0 var(--heading);
		font-weight: 600;
	}

	.knowledge-subsection {
		margin: 0.35rem 0 0 0.75rem;
		padding-left: 0.35rem;
		border-left: 1px solid var(--border);
	}

	.knowledge-subsection-link {
		display: block;
		width: 100%;
		margin: 0;
		padding: 0.5rem 0.65rem;
		border-radius: 5px;
		color: var(--heading);
		font-size: 0.78rem;
		line-height: 1.45;
	}

	a.knowledge-subsection-link:hover,
	a.knowledge-subsection-link.active {
		background: var(--accent-faint);
	}

	.knowledge-subsection-link strong {
		font-weight: 600;
	}

	.knowledge-domain .knowledge-subsection-list li a {
		padding: 0.48rem 0.65rem 0.48rem 1.1rem;
		font-size: 0.74rem;
	}

	.knowledge-empty-category {
		margin: 0;
		padding-left: 0.75rem;
		color: var(--text-faint);
		font-size: 0.72rem;
	}

	@media (max-width: 980px) {
		.knowledge-sidebar {
			position: relative;
			top: 0;
			max-height: none;
			padding: 0;
			border: 1px solid var(--text-faint);
			border-radius: var(--panel-radius);
			background: rgba(255, 255, 255, 0.76);
			box-shadow: var(--ink-shadow-flat);
			overflow: visible;
		}

		.knowledge-nav-details > summary {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 1rem;
			padding: 0.9rem 1rem;
			color: var(--heading);
			font-family: var(--font-mono);
			font-size: 0.66rem;
			letter-spacing: 0.06em;
			list-style: none;
			text-transform: uppercase;
			cursor: pointer;
		}

		.knowledge-nav-details > summary::-webkit-details-marker {
			display: none;
		}

		.knowledge-nav-details > summary::before {
			content: "+";
			font-size: 1rem;
			line-height: 1;
		}

		.knowledge-nav-details[open] > summary::before {
			content: "−";
		}

		.knowledge-nav-details > summary strong {
			margin-left: auto;
			color: var(--text-faint);
			font-size: 0.61rem;
			font-weight: 500;
		}

		.knowledge-nav-details nav {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 1.5rem;
			padding: 1rem;
			border-top: 1px solid var(--border);
		}

		.knowledge-overview-link {
			grid-column: 1 / -1;
			margin-bottom: 0;
		}

		.knowledge-domain {
			margin-bottom: 0;
		}
	}

	@media (max-width: 620px) {
		.knowledge-nav-details nav {
			grid-template-columns: 1fr;
		}
	}
</style>
