---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'> & {
	active?: boolean;
};

const { href, active, class: className, ...props } = Astro.props;
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const linkPath = href?.replace(/\/$/, '') || '/';
const isCurrentPage = linkPath === pathname;
const isActive = active ?? (isCurrentPage ||
	(linkPath !== '/' && pathname.startsWith(`${linkPath}/`)));
---

<a
	href={href}
	class:list={[className, { active: isActive }]}
	aria-current={isActive ? (isCurrentPage ? 'page' : 'true') : undefined}
	{...props}
>
	<slot />
</a>
<style>
	a {
		display: inline-block;
		text-decoration: none;
	}
	a.active {
		color: var(--heading);
		font-weight: 600;
	}
</style>
