---
import PageHero from '../../components/PageHero.astro';
import PostCard from '../../components/PostCard.astro';
import TagPill from '../../components/TagPill.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getBlogPosts, getTags } from '../../lib/blog';

const posts = await getBlogPosts();
const featured = posts[0];
const remaining = posts.slice(1);
const tags = getTags(posts);
---

<SiteLayout
	title={`Writing — ${SITE_TITLE}`}
	description={SITE_DESCRIPTION}
>
	<main>
		<PageHero
			variant="writing"
			eyebrow="Research & field notes"
			title="Writing"
			summary="Technical analysis across application and API security, cloud security, ML and agentic security, threat modeling, and defensive engineering."
			meta={`${String(posts.length).padStart(2, '0')} published ${posts.length === 1 ? 'article' : 'articles'}`}
		/>

		{tags.length > 0 && (
			<nav class="topic-nav" aria-label="Filter writing by tag">
				<span>Browse by tag</span>
				<div>
					{tags.map((tag) => <TagPill tag={tag} />)}
				</div>
			</nav>
		)}

		{featured ? (
			<section class="featured-section" aria-labelledby="featured-heading">
				<p class="section-label" id="featured-heading">Featured research</p>
				<PostCard post={featured} variant="featured" />
			</section>
		) : (
			<div class="empty">No published writing yet.</div>
		)}

		{remaining.length > 0 && (
			<section class="archive-section" aria-labelledby="archive-heading">
				<div class="archive-heading">
					<p class="section-label" id="archive-heading">More writing</p>
					<span>{remaining.length} {remaining.length === 1 ? 'article' : 'articles'}</span>
				</div>
				<div class="post-grid">
					{remaining.map((post) => <PostCard post={post} variant="grid" />)}
				</div>
			</section>
		)}
	</main>
</SiteLayout>

<style>
	main {
		padding-top: 5.5rem;
		padding-bottom: 7rem;
	}

	.topic-nav {
		display: flex;
		align-items: center;
		gap: 1.5rem;
		padding: 1.35rem 0;
		border-bottom: 1px solid var(--border);
	}

	.topic-nav > span {
		flex-shrink: 0;
		color: var(--text-faint);
		font-family: var(--font-mono);
		font-size: 0.64rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.topic-nav > div {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
	}

	.featured-section {
		padding-top: 5rem;
	}

	.section-label,
	.archive-heading > span {
		color: var(--accent-strong);
		font-family: var(--font-mono);
		font-size: 0.68rem;
		letter-spacing: 0.09em;
		text-transform: uppercase;
	}

	.section-label {
		margin: 0 0 1.25rem;
	}

	.archive-section {
		padding-top: 6rem;
	}

	.archive-heading {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 2rem;
		padding-bottom: 1rem;
		border-bottom: 1px solid var(--border);
	}

	.post-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}

	.empty {
		margin-top: 4rem;
		padding: 3rem;
		border: 1px dashed var(--text-faint);
		border-radius: var(--panel-radius);
		box-shadow: var(--ink-shadow-flat);
		color: var(--text-muted);
		text-align: center;
	}

	@media (max-width: 620px) {
		main {
			padding-top: 4rem;
			padding-bottom: 5rem;
		}

		.topic-nav {
			align-items: flex-start;
			flex-direction: column;
		}

		.featured-section {
			padding-top: 3.75rem;
		}

		.post-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
