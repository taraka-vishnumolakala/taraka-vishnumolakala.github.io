---
const today = new Date();
---

<footer>
	<div class="footer-shell">
		<p>&copy; {today.getFullYear()} Taraka Vishnumolakala</p>
		<nav aria-label="Footer">
			<a
				href="https://github.com/taraka-vishnumolakala"
				target="_blank"
				rel="noopener noreferrer">GitHub ↗</a
			>
			<a
				href="https://www.linkedin.com/in/tvishnumolakala/"
				target="_blank"
				rel="noopener noreferrer">LinkedIn ↗</a
			>
		</nav>
	</div>
</footer>

<style>
	footer {
		margin-top: auto;
		background: var(--heading);
		color: rgba(255, 255, 255, 0.72);
	}

	.footer-shell {
		width: min(calc(100% - 3rem), var(--container));
		margin: 0 auto;
		min-height: 64px;
		padding: 1.15rem 0;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 2rem;
	}

	nav {
		display: flex;
		align-items: center;
		gap: 1.25rem;
	}

	nav a {
		color: rgba(255, 255, 255, 0.72);
		font-size: 0.76rem;
		font-weight: 500;
	}

	nav a:hover {
		color: #fff;
	}

	.footer-shell > p {
		margin: 0;
		color: rgba(255, 255, 255, 0.42);
		font-family: var(--font-mono);
		font-size: 0.66rem;
		letter-spacing: 0.04em;
	}

	@media (max-width: 760px) {
		.footer-shell {
			width: min(calc(100% - 2rem), var(--container));
			min-height: 58px;
			gap: 1rem;
		}
	}
</style>
