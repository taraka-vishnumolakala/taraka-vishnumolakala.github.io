---
import PageHero from '../../components/PageHero.astro';
import PostCard from '../../components/PostCard.astro';
import { SITE_TITLE } from '../../consts';
import SiteLayout from '../../layouts/SiteLayout.astro';
import {
	addReadingTime,
	formatTag,
	getBlogEntries,
	type BlogEntry,
} from '../../lib/blog';

type Props = {
	tag: string;
	posts: BlogEntry[];
};

export async function getStaticPaths() {
	const posts = await getBlogEntries();
	const tags = new Set(posts.flatMap((post) => post.data.tags ?? []));

	return [...tags].map((tag) => ({
		params: { tag },
		props: {
			tag,
			posts: posts.filter((post) => post.data.tags?.includes(tag)),
		},
	}));
}

const { tag, posts } = Astro.props;
const enrichedPosts = addReadingTime(posts);
const displayTag = formatTag(tag);
---

<SiteLayout
	title={`${displayTag} — ${SITE_TITLE}`}
	description={`Security research and writing about ${displayTag}`}
>
	<main>
		<PageHero
			variant="tag"
			eyebrow="Tag index"
			title={displayTag}
			summary={`Research, field notes, and practical security guidance tagged ${displayTag}.`}
			meta={`${String(posts.length).padStart(2, '0')} ${posts.length === 1 ? 'article' : 'articles'}`}
			backHref="/tags"
			backLabel="All tags"
		/>

		<section class="post-list" aria-label={`Articles about ${displayTag}`}>
			{enrichedPosts.map((post, index) => (
				<PostCard post={post} variant="list" index={index} />
			))}
		</section>
	</main>
</SiteLayout>

<style>
	main {
		max-width: 1100px;
		padding-top: 5.5rem;
		padding-bottom: 7rem;
	}

	.post-list {
		margin-top: 4rem;
		border-top: 1px solid var(--border);
	}

	@media (max-width: 760px) {
		main {
			padding-top: 4rem;
			padding-bottom: 5rem;
		}

		.post-list {
			margin-top: 3rem;
		}
	}
</style>
