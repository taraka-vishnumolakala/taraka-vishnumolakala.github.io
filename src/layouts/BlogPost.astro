---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'] & {
	id: string;
	headings?: MarkdownHeading[];
	readingTime?: number;
};

type TocSection = {
	slug: string;
	text: string;
	children: { slug: string; text: string }[];
};

const {
	id,
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	author,
	tags,
	headings = [],
	readingTime,
} = Astro.props;

const tocSections: TocSection[] = [];
let currentSection: TocSection | null = null;
for (const h of headings) {
	if (h.depth === 2) {
		currentSection = { slug: h.slug, text: h.text, children: [] };
		tocSections.push(currentSection);
	} else if (h.depth === 3 && currentSection) {
		currentSection.children.push({ slug: h.slug, text: h.text });
	}
}
const hasToc = tocSections.length > 0;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<link rel="alternate" type="text/markdown" href={`/blog/${id}.md`} />
		<style>
			main {
				max-width: 1480px;
			}

			.hero-image {
				width: 100%;
				margin-bottom: 2rem;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
			}

			.layout {
				display: grid;
				grid-template-columns: 1fr minmax(0, 860px) 1fr;
				gap: 3rem;
				align-items: start;
			}

			.layout.no-toc {
				grid-template-columns: minmax(0, 860px);
				justify-content: center;
			}

			.toc {
				position: sticky;
				top: 1.5rem;
				width: 240px;
				justify-self: end;
				font-size: 0.8rem;
				line-height: 1.5;
			}

			.toc-label {
				font-size: 0.72rem;
				letter-spacing: 0.1em;
				text-transform: uppercase;
				color: var(--text-faint);
				margin: 0 0 0.75rem 1.2rem;
			}

			.toc-details > summary {
				display: none;
			}

			.toc ul {
				list-style: none;
				margin: 0;
				padding: 0;
			}

			.toc-list > li {
				margin: 0;
			}

			.toc a {
				display: flex;
				align-items: center;
				gap: 0.7rem;
				padding: 0.4rem 0;
				color: #8a8a8a;
				text-decoration: none;
				transition: color 0.15s ease;
				line-height: 1.45;
			}

			.toc a::before {
				content: '';
				width: 8px;
				height: 1px;
				background: #e0e0e0;
				flex-shrink: 0;
				transition:
					width 0.15s ease,
					background 0.15s ease;
			}

			.toc a:hover {
				color: var(--heading);
				text-decoration: none;
			}

			.toc a.active {
				color: var(--heading);
				font-weight: 500;
			}

			.toc a.active::before {
				width: 16px;
				background: var(--heading);
			}

			.toc-children {
				max-height: 0;
				overflow: hidden;
				opacity: 0;
				transition:
					max-height 0.3s ease,
					opacity 0.2s ease;
			}

			.toc-section.expanded > .toc-children {
				max-height: 2000px;
				opacity: 1;
			}

			.toc-children a {
				padding-left: 1rem;
				font-size: 0.8rem;
				color: var(--text-faint);
			}

			.toc-children a::before {
				width: 6px;
			}

			.toc-children a:hover {
				color: var(--heading);
			}

			.toc-children a.active {
				color: var(--heading);
			}

			.toc-children a.active::before {
				width: 10px;
			}

			.prose {
				min-width: 0;
				color: var(--text);
			}

			.prose :global(h2),
			.prose :global(h3),
			.prose :global(h4) {
				scroll-margin-top: 1.5rem;
			}

			.post-header {
				margin-bottom: 2rem;
			}
			.breadcrumb {
				font-size: 0.85rem;
				color: var(--text-muted);
				margin: 0;
			}
			.breadcrumb a {
				color: inherit;
				text-decoration: none;
				transition: color 0.15s ease;
			}
			.breadcrumb a:hover {
				color: var(--heading);
			}
			.breadcrumb .sep {
				padding: 0 0.5rem;
				color: var(--text-faint);
			}
			.post-title {
				font-size: clamp(2.5rem, 5vw, 3.5rem);
				font-weight: 500;
				letter-spacing: -0.02em;
				line-height: 1.1;
				margin: 0.75rem 0 2rem;
			}
			.post-meta {
				display: flex;
				flex-wrap: wrap;
				gap: 2.5rem;
				padding-bottom: 1.5rem;
				border-bottom: 1px dotted #c9c9c9;
			}
			.meta-label {
				display: block;
				font-size: 0.75rem;
				color: var(--text-faint);
				margin-bottom: 0.2rem;
			}
			.meta-value {
				font-size: 0.9rem;
				color: var(--heading);
			}

			@media (max-width: 960px) {
				.layout {
					grid-template-columns: 1fr;
					gap: 0;
				}

				.toc {
					position: relative;
					top: 0;
					width: auto;
					justify-self: stretch;
					margin-bottom: 2rem;
					padding: 1rem;
					border: 1px solid var(--border);
					background: var(--bg-subtle);
					border-radius: 8px;
				}

				.toc-details > summary {
					cursor: pointer;
					list-style: none;
					font-size: 0.78rem;
					letter-spacing: 0.08em;
					text-transform: uppercase;
					color: var(--text-muted);
					padding: 0.25rem 0;
					display: flex;
					align-items: center;
					gap: 0.5rem;
				}

				.toc-details > summary::-webkit-details-marker {
					display: none;
				}

				.toc-details > summary::before {
					content: '▸';
					transition: transform 0.15s ease;
					color: var(--text-faint);
				}

				.toc-details[open] > summary::before {
					transform: rotate(90deg);
				}

				.toc-label {
					display: none;
				}

				.toc-list {
					margin-top: 0.5rem;
				}

				/* On mobile, expand all sections so the entire TOC is browseable */
				.toc-children {
					max-height: 2000px;
					opacity: 1;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
				</div>
				<div class={`layout ${hasToc ? '' : 'no-toc'}`}>
					{hasToc && (
						<aside class="toc" aria-label="Table of contents">
							<details class="toc-details" open>
								<summary>On this page</summary>
								<p class="toc-label">On this page</p>
								<ul class="toc-list">
									{tocSections.map((section) => (
										<li class="toc-section" data-toc-section={section.slug}>
											<a
												href={`#${section.slug}`}
												data-toc-link={section.slug}
											>
												{section.text}
											</a>
											{section.children.length > 0 && (
												<ul class="toc-children">
													{section.children.map((child) => (
														<li>
															<a
																href={`#${child.slug}`}
																data-toc-link={child.slug}
															>
																{child.text}
															</a>
														</li>
													))}
												</ul>
											)}
										</li>
									))}
								</ul>
							</details>
						</aside>
					)}
					<div class="prose">
						<header class="post-header">
							<p class="breadcrumb">
								<a href="/blog">Blog</a>
								{
									tags?.[0] && (
										<>
											<span class="sep">/</span>
											<span>{tags[0]}</span>
										</>
									)
								}
							</p>
							<h1 class="post-title">{title}</h1>
							<div class="post-meta">
								<div class="meta-col">
									<span class="meta-label">Written by</span>
									<span class="meta-value">{author}</span>
								</div>
								<div class="meta-col">
									<span class="meta-label">Published</span>
									<span class="meta-value"><FormattedDate date={pubDate} /></span>
								</div>
								{
									updatedDate && (
										<div class="meta-col">
											<span class="meta-label">Last updated</span>
											<span class="meta-value">
												<FormattedDate date={updatedDate} />
											</span>
										</div>
									)
								}
								{
									readingTime && (
										<div class="meta-col">
											<span class="meta-label">Reading time</span>
											<span class="meta-value">{readingTime} min read</span>
										</div>
									)
								}
							</div>
						</header>
						<slot />
					</div>
				</div>
			</article>
		</main>
		<Footer />

		<script>
			const links = document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]');
			if (links.length > 0) {
				const linkBySlug = new Map<string, HTMLAnchorElement>();
				const sectionBySlug = new Map<string, HTMLElement>();
				const allSections = Array.from(
					document.querySelectorAll<HTMLElement>('[data-toc-section]'),
				);

				links.forEach((link) => {
					const slug = link.dataset.tocLink;
					if (!slug) return;
					linkBySlug.set(slug, link);
					const section = link.closest<HTMLElement>('[data-toc-section]');
					if (section) sectionBySlug.set(slug, section);
				});

				const headings = Array.from(linkBySlug.keys())
					.map((slug) => document.getElementById(slug))
					.filter((el): el is HTMLElement => el !== null);

				let activeSlug: string | null = null;
				const setActive = (slug: string | null) => {
					if (slug === activeSlug) return;
					if (activeSlug) linkBySlug.get(activeSlug)?.classList.remove('active');
					if (slug) linkBySlug.get(slug)?.classList.add('active');
					activeSlug = slug;

					const activeSection = slug ? sectionBySlug.get(slug) : null;
					allSections.forEach((s) => {
						s.classList.toggle('expanded', s === activeSection);
					});
				};

				const observer = new IntersectionObserver(
					(entries) => {
						const visible = entries
							.filter((e) => e.isIntersecting)
							.sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);

						if (visible.length > 0) {
							setActive(visible[0].target.id);
							return;
						}

						const above = headings.filter((h) => h.getBoundingClientRect().top < 100);
						if (above.length > 0) {
							setActive(above[above.length - 1].id);
						}
					},
					{ rootMargin: '-80px 0px -70% 0px', threshold: 0 },
				);

				headings.forEach((h) => observer.observe(h));
			}
		</script>
	</body>
</html>
