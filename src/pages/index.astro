---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<div class="split">
				<div class="split-image">
					<img src="/taraka.png" alt="Taraka Vishnumolakala" />
				</div>
				<div class="split-content">
					<p class="job-title">Sr. Cybersecurity Engineer, Security Architecture · <a href="https://www.workday.com" target="_blank" rel="noopener noreferrer">Workday</a></p>
					<p>
						I started my career as a software engineer, which gave me a deep
						appreciation for the decisions developers make under pressure — and
						the oversights those decisions can leave behind. That perspective
						shaped how I approach security: not as an external audit, but as
						someone who understands where systems are most likely to fail and
						how those gaps translate into real attack surface.
					</p>
					<p>
						Today I specialize in application &amp; API security, cloud
						infrastructure hardening, threat modeling, and offensive security —
						including pentesting and red teaming that feeds actionable findings
						back into the engineering process. I also focus on AI/ML risk:
						assessing model attack surfaces and designing controls for systems
						whose behavior is inherently non-deterministic.
					</p>
					<p>
						I care about building security cultures that last — running security
						champions programs, embedding security awareness into engineering
						workflows, and empowering developers to own security as a natural
						part of how they build.
					</p>
					<p class="links">
						<a href="https://github.com/taraka-vishnumolakala" target="_blank" rel="noopener noreferrer">
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.2c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65S8.93 17.38 9 18v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
							GitHub
						</a>
						<a href="https://www.linkedin.com/in/tvishnumolakala/" target="_blank" rel="noopener noreferrer">
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
							LinkedIn
						</a>
					</p>
				</div>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		max-width: 900px;
		padding: 3rem 1rem;
	}

	.split {
		display: flex;
		flex-wrap: nowrap;
		gap: 3.5rem;
		align-items: flex-start;
	}

	.split-image {
		flex: 0 0 38%;
	}

	.split-image img {
		width: 100%;
		height: auto;
		display: block;
		border-radius: 6px;
		object-fit: cover;
	}

	.split-content {
		flex: 1;
		padding-top: 0.25rem;
	}

	.job-title {
		font-family: var(--font-mono);
		font-size: 0.78rem;
		color: var(--text-muted);
		margin: 0 0 1.5rem !important;
		letter-spacing: 0.01em;
	}

	.split-content p {
		font-size: 1rem;
		line-height: 1.75;
		color: var(--text);
		margin: 0 0 1.25rem;
	}

	.split-content p:last-child {
		margin-bottom: 0;
	}

	.split-content a {
		color: var(--text);
		text-decoration: underline;
		text-underline-offset: 3px;
		text-decoration-color: var(--border);
		transition:
			color 0.15s ease,
			text-decoration-color 0.15s ease;
	}

	.split-content a:hover {
		color: var(--heading);
		text-decoration-color: var(--text-muted);
	}

	.links {
		display: flex;
		gap: 1.5rem;
		margin-top: 0.5rem;
	}

	.links a {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-family: var(--font-mono);
		font-size: 0.78rem;
		text-decoration: none !important;
		color: var(--text-muted) !important;
		transition: color 0.15s ease !important;
	}

	.links a:hover {
		color: var(--heading) !important;
	}

	@media (max-width: 640px) {
		.split {
			flex-direction: column;
			gap: 2rem;
		}

		.split-image {
			flex: none;
			width: 60%;
			margin: 0 auto;
		}
	}
</style>
