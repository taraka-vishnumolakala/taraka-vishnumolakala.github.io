---
import { render } from 'astro:content';
import { mdxComponents } from '../../components/mdx';
import { SITE_TITLE } from '../../consts';
import KnowledgeLayout from '../../layouts/KnowledgeLayout.astro';
import {
	getKnowledgeNotes,
	type KnowledgeNote,
} from '../../lib/knowledge';

export async function getStaticPaths() {
	const notes = await getKnowledgeNotes();

	return notes.map((note) => ({
		params: { slug: note.id },
		props: note,
	}));
}

type Props = KnowledgeNote;

const note = Astro.props;
const notes = await getKnowledgeNotes();
const { Content } = await render(note);
---

<KnowledgeLayout
	pageTitle={`${note.data.title} — Knowledge Base — ${SITE_TITLE}`}
	title={note.data.title}
	description={note.data.description}
	{notes}
	activeId={note.id}
	category={note.data.category}
	pubDate={note.data.pubDate}
	updatedDate={note.data.updatedDate}
	readingTime={note.readingTime}
	topics={note.data.topics}
>
	<div class="prose">
		<Content components={mdxComponents} />
	</div>
</KnowledgeLayout>
