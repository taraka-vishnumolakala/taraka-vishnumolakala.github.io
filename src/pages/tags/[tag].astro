---
import { type CollectionEntry, getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
import { getReadingTime } from '../../lib/reading-time';

type Props = {
	tag: string;
	posts: CollectionEntry<'blog'>[];
};

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	const tags = new Set(posts.flatMap((post) => post.data.tags ?? []));

	return [...tags].map((tag) => ({
		params: { tag },
		props: {
			tag,
			posts: posts
				.filter((post) => post.data.tags?.includes(tag))
				.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
		},
	}));
}

const { tag, posts } = Astro.props;
const enrichedPosts = posts.map((post) => ({
	...post,
	readingTime: getReadingTime(post.body ?? ''),
}));
const displayTag = tag
	.split('-')
	.map((word) => (word.toLowerCase() === 'mcp' ? 'MCP' : word[0]?.toUpperCase() + word.slice(1)))
	.join(' ');
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`${displayTag} — ${SITE_TITLE}`}
			description={`Security research and writing about ${displayTag}`}
		/>
	</head>
	<body>
		<Header />
		<main>
			<header class="page-hero">
				<div>
					<a class="back-link" href="/tags">← All topics</a>
					<p class="eyebrow">Topic index</p>
					<h1>{displayTag}</h1>
				</div>
				<div class="topic-summary">
					<p>
						Research, field notes, and practical security guidance filed
						under {displayTag}.
					</p>
					<span>{String(posts.length).padStart(2, '0')} {posts.length === 1 ? 'article' : 'articles'}</span>
				</div>
			</header>

			<section class="post-list" aria-label={`Articles about ${displayTag}`}>
				{enrichedPosts.map((post, index) => (
					<article class="post-card">
						<div class="post-index">{String(index + 1).padStart(2, '0')}</div>
						<div class="post-copy">
							<div class="article-meta">
								<span><FormattedDate date={post.data.pubDate} /></span>
								<span>{post.readingTime} min read</span>
								{post.data.series && <span>{post.data.series}</span>}
							</div>
							<h2><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2>
							<p>{post.data.description}</p>
						</div>
						<a class="read-link" href={`/blog/${post.id}/`}>
							Read article <span aria-hidden="true">→</span>
						</a>
					</article>
				))}
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		max-width: 1100px;
		padding-top: 5.5rem;
		padding-bottom: 7rem;
	}

	.page-hero {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(320px, 0.6fr);
		gap: clamp(3rem, 9vw, 7rem);
		align-items: end;
		padding-bottom: 4rem;
		border-bottom: 1px solid var(--border);
	}

	.back-link {
		display: inline-block;
		margin-bottom: 2rem;
		color: var(--text-muted);
		font-size: 0.82rem;
	}

	.back-link:hover {
		color: var(--accent-strong);
		transform: translateX(-3px);
	}

	.page-hero h1 {
		font-size: clamp(3.4rem, 8vw, 6.5rem);
		line-height: 0.95;
	}

	.topic-summary p {
		margin: 0 0 1rem;
		color: var(--text-secondary);
		line-height: 1.72;
	}

	.topic-summary span {
		color: var(--accent-strong);
		font-family: var(--font-mono);
		font-size: 0.66rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.post-list {
		margin-top: 4rem;
		border-top: 1px solid var(--border);
	}

	.post-card {
		display: grid;
		grid-template-columns: 44px minmax(0, 1fr) auto;
		gap: 2rem;
		align-items: start;
		padding: 2.5rem 0;
		border-bottom: 1px solid var(--border);
	}

	.post-index {
		color: var(--accent);
		font-family: var(--font-mono);
		font-size: 0.66rem;
	}

	.article-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem 1.1rem;
		margin-bottom: 1rem;
		color: var(--text-faint);
		font-family: var(--font-mono);
		font-size: 0.62rem;
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}

	.post-card h2 {
		margin-bottom: 0.8rem;
		font-size: clamp(1.8rem, 4vw, 2.7rem);
	}

	.post-card h2 a:hover {
		color: var(--accent-strong);
	}

	.post-copy > p {
		max-width: 680px;
		margin: 0;
		color: var(--text-secondary);
		line-height: 1.7;
	}

	.read-link {
		margin-top: 1.8rem;
		color: var(--accent-strong);
		font-size: 0.82rem;
		font-weight: 600;
		white-space: nowrap;
	}

	.read-link:hover {
		color: var(--heading);
		transform: translateX(3px);
	}

	@media (max-width: 760px) {
		main {
			padding-top: 4rem;
			padding-bottom: 5rem;
		}

		.page-hero {
			grid-template-columns: 1fr;
			gap: 2rem;
			padding-bottom: 3rem;
		}

		.post-list {
			margin-top: 3rem;
		}

		.post-card {
			grid-template-columns: 34px minmax(0, 1fr);
			gap: 1.25rem;
			padding: 2rem 0;
		}

		.read-link {
			grid-column: 2;
			margin-top: 0;
		}
	}
</style>
