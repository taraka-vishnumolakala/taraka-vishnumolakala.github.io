---
import PageHero from '../../components/PageHero.astro';
import TagCard from '../../components/TagCard.astro';
import { SITE_TITLE } from '../../consts';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getBlogEntries, getTagCounts } from '../../lib/blog';

const tags = getTagCounts(await getBlogEntries());
---

<SiteLayout
	title={`Tags — ${SITE_TITLE}`}
	description="Browse security research and writing by tag"
>
	<main>
		<PageHero
			variant="tags"
			eyebrow="Research index"
			title="Tags"
			summary="Browse writing by focus area, security practice, and system concern."
		/>

		{tags.length === 0 ? (
			<p class="empty">No tags have been published yet.</p>
		) : (
			<section class="topic-grid" aria-label="Writing tags">
				{tags.map(([tag, count], index) => (
					<TagCard tag={tag} count={count} index={index} />
				))}
			</section>
		)}
	</main>
</SiteLayout>

<style>
	main {
		padding-top: 5.5rem;
		padding-bottom: 7rem;
	}

	.topic-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		margin-top: 4rem;
		border-top: 1px solid var(--border);
		border-left: 1px solid var(--border);
	}

	.empty {
		margin-top: 4rem;
		color: var(--text-muted);
	}

	@media (max-width: 760px) {
		main {
			padding-top: 4rem;
			padding-bottom: 5rem;
		}

		.topic-grid {
			grid-template-columns: 1fr;
			margin-top: 3rem;
		}
	}
</style>
