---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header>
	<nav>
		<div class="nav-left">
			<h2><a href="/" class="site-name">{SITE_TITLE}</a></h2>
		</div>
		<div class="nav-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/tags">Tags</HeaderLink>
		</div>
	</nav>
</header>

<style>
	header {
		margin: 0;
		background: var(--bg-card);
		border-bottom: 1px solid var(--border-soft);
	}

	nav {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		padding: 0 1.5rem;
	}

	.nav-links {
		display: flex;
		gap: 0.25rem;
	}

	.nav-links a {
		padding: 1em 0.6em;
		color: var(--text);
		font-size: 0.95rem;
		border-bottom: 2px solid transparent;
		text-decoration: none;
		transition: color 0.15s ease;
	}

	.nav-links a:hover {
		color: var(--heading);
	}

	.nav-links a.active {
		color: var(--heading);
		border-bottom-color: var(--accent);
	}

	.nav-left {
		display: flex;
		align-items: center;
	}

	.nav-left h2 {
		margin: 0;
		font-size: 1.5rem;
		font-weight: 600;
		line-height: 1;
		border: none;
		padding: 0;
	}

	.site-name {
		color: var(--heading);
		text-decoration: none;
		letter-spacing: -0.02em;
		transition: opacity 0.15s ease;
	}

	.site-name:hover {
		opacity: 0.65;
		color: var(--heading);
		text-decoration: none;
	}
</style>
