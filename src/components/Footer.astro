---
const today = new Date();
---

<footer>
	<div class="footer-inner">
		<p>&copy; {today.getFullYear()} Taraka Vishnumolakala</p>
		<nav aria-label="Footer">
			<a href="/blog">Writing</a>
			<a href="/rss.xml">RSS</a>
			<a
				href="https://github.com/taraka-vishnumolakala"
				target="_blank"
				rel="noopener noreferrer">GitHub</a
			>
			<a
				href="https://www.linkedin.com/in/tvishnumolakala/"
				target="_blank"
				rel="noopener noreferrer">LinkedIn</a
			>
		</nav>
	</div>
</footer>

<style>
	footer {
		padding: 2em 1em;
		font-size: 0.875rem;
		color: var(--text-muted);
		border-top: 1px solid var(--border);
		transition:
			color 0.2s ease,
			border-color 0.2s ease;
	}

	.footer-inner {
		max-width: 1100px;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
	}

	p {
		margin: 0;
	}

	nav {
		display: flex;
		align-items: center;
		gap: 1.25rem;
	}

	a {
		color: var(--text-muted);
		text-decoration: none;
		transition: color 0.15s ease;
	}

	a:hover {
		color: var(--heading);
	}

	@media (max-width: 540px) {
		.footer-inner {
			flex-direction: column;
			gap: 0.75rem;
			text-align: center;
		}

		nav {
			flex-wrap: wrap;
			justify-content: center;
		}
	}
</style>
