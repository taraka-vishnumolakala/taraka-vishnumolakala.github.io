---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header>
	<nav>
		<div class="nav-left">
			<h2><a href="/" class="site-name">{SITE_TITLE}</a></h2>
		</div>
		<div class="nav-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/tags">Tags</HeaderLink>
		</div>
		<div class="nav-right">
			<button id="theme-toggle" aria-label="Toggle theme" title="Toggle theme"></button>
		</div>
	</nav>
</header>

<script>
	const btn = document.getElementById('theme-toggle') as HTMLButtonElement;
	const root = document.documentElement;
	const cycle = [null, 'light', 'dark'] as const;

	const sunIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>`;
	const moonIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9z"/></svg>`;
	const systemIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>`;

	function getStored() {
		return localStorage.getItem('theme') as 'light' | 'dark' | null;
	}

	function updateButton(theme: 'light' | 'dark' | null) {
		if (theme === 'light') {
			btn.innerHTML = sunIcon;
			btn.title = 'Light theme';
		} else if (theme === 'dark') {
			btn.innerHTML = moonIcon;
			btn.title = 'Dark theme';
		} else {
			btn.innerHTML = systemIcon;
			btn.title = 'System theme';
		}
	}

	function apply(theme: 'light' | 'dark' | null) {
		if (theme) {
			root.setAttribute('data-theme', theme);
			localStorage.setItem('theme', theme);
		} else {
			root.removeAttribute('data-theme');
			localStorage.removeItem('theme');
		}
		updateButton(theme);
	}

	btn.addEventListener('click', () => {
		const current = getStored();
		const idx = cycle.indexOf(current);
		const next = cycle[(idx + 1) % cycle.length];
		apply(next);
	});

	updateButton(getStored());
</script>

<style>
	header {
		margin: 0;
		background: var(--bg-card);
		border-bottom: 1px solid var(--border);
		transition:
			background-color 0.2s ease,
			border-color 0.2s ease;
	}

	nav {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		padding: 0 1.5rem;
	}

	.nav-links {
		display: flex;
		gap: 0.25rem;
	}

	.nav-links a {
		padding: 1em 0.6em;
		color: var(--text);
		font-size: 0.95rem;
		border-bottom: 2px solid transparent;
		text-decoration: none;
		transition: color 0.15s ease;
	}

	.nav-links a:hover {
		color: var(--heading);
	}

	.nav-links a.active {
		color: var(--heading);
		border-bottom-color: var(--accent);
	}

	.nav-left {
		display: flex;
		align-items: center;
	}

	.nav-left h2 {
		margin: 0;
		font-size: 1.25rem;
		font-weight: 600;
		line-height: 1;
	}

	.site-name {
		color: var(--heading);
		text-decoration: none;
		letter-spacing: -0.02em;
		transition: opacity 0.15s ease;
	}

	.site-name:hover {
		opacity: 0.65;
		color: var(--heading);
	}

	.nav-right {
		display: flex;
		justify-content: flex-end;
	}

	#theme-toggle {
		background: transparent;
		border: none;
		border-radius: 50%;
		width: 34px;
		height: 34px;
		padding: 0;
		cursor: pointer;
		color: var(--text-muted);
		display: flex;
		align-items: center;
		justify-content: center;
		transition:
			background-color 0.15s ease,
			color 0.15s ease;
	}

	#theme-toggle:hover {
		background-color: var(--bg-code);
		color: var(--heading);
	}
</style>
