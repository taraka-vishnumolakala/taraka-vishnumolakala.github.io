---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const posts = await getCollection('blog');

const tagCounts = new Map<string, number>();
for (const post of posts) {
	for (const tag of post.data.tags ?? []) {
		tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
	}
}

const tags = [...tagCounts.entries()].sort((a, b) => a[0].localeCompare(b[0]));

const descriptions: Record<string, string> = {
	mcp: 'Model Context Protocol architecture, capabilities, and security boundaries.',
	'mcp-security-series': 'The complete practitioner-focused MCP Security research series.',
	security: 'Security architecture, defensive engineering, and applied analysis.',
	'threat-modeling': 'Methods for finding credible attack paths in complex systems.',
};

const formatTag = (tag: string) =>
	tag
		.split('-')
		.map((word) => (word.toLowerCase() === 'mcp' ? 'MCP' : word[0]?.toUpperCase() + word.slice(1)))
		.join(' ');
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Topics — ${SITE_TITLE}`}
			description="Browse security research and writing by topic"
		/>
	</head>
	<body>
		<Header />
		<main>
			<header class="page-hero">
				<div>
					<p class="eyebrow">Research index</p>
					<h1>Topics</h1>
				</div>
				<p>
					Browse the ideas, protocols, and security practices that connect
					the writing across this site.
				</p>
			</header>

			{tags.length === 0 ? (
				<p class="empty">No topics have been published yet.</p>
			) : (
				<section class="topic-grid" aria-label="Writing topics">
					{tags.map(([tag, count], index) => (
						<a class="topic-card" href={`/tags/${tag}/`}>
							<div class="topic-meta">
								<span>{String(index + 1).padStart(2, '0')}</span>
								<span>{count} {count === 1 ? 'article' : 'articles'}</span>
							</div>
							<h2>{formatTag(tag)}</h2>
							<p>
								{descriptions[tag] ??
									`Research and field notes about ${formatTag(tag)}.`}
							</p>
							<strong>Explore topic <span aria-hidden="true">→</span></strong>
						</a>
					))}
				</section>
			)}
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		padding-top: 5.5rem;
		padding-bottom: 7rem;
	}

	.page-hero {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(360px, 0.65fr);
		gap: clamp(3rem, 10vw, 9rem);
		align-items: end;
		padding-bottom: 4.5rem;
		border-bottom: 1px solid var(--border);
	}

	.page-hero h1 {
		font-size: clamp(4rem, 10vw, 8rem);
		line-height: 0.92;
	}

	.page-hero > p {
		margin: 0;
		color: var(--text-secondary);
		font-size: 1.08rem;
		line-height: 1.72;
	}

	.topic-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		margin-top: 4rem;
		border-top: 1px solid var(--border);
		border-left: 1px solid var(--border);
	}

	.topic-card {
		min-height: 330px;
		display: flex;
		flex-direction: column;
		padding: clamp(1.75rem, 4vw, 3rem);
		border-right: 1px solid var(--border);
		border-bottom: 1px solid var(--border);
		background: rgba(255, 255, 255, 0.42);
	}

	.topic-card:hover {
		z-index: 1;
		background: var(--bg-card);
		box-shadow: var(--box-shadow-soft);
		transform: translateY(-3px);
	}

	.topic-meta {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 3rem;
		color: var(--text-faint);
		font-family: var(--font-mono);
		font-size: 0.64rem;
		letter-spacing: 0.07em;
		text-transform: uppercase;
	}

	.topic-meta span:first-child {
		color: var(--accent);
	}

	.topic-card h2 {
		margin-bottom: 0.8rem;
		font-size: clamp(2rem, 4vw, 3rem);
	}

	.topic-card > p {
		max-width: 480px;
		margin: 0 0 2rem;
		color: var(--text-secondary);
		line-height: 1.7;
	}

	.topic-card strong {
		margin-top: auto;
		color: var(--accent-strong);
		font-size: 0.84rem;
	}

	.topic-card:hover strong {
		color: var(--heading);
	}

	.empty {
		margin-top: 4rem;
		color: var(--text-muted);
	}

	@media (max-width: 760px) {
		main {
			padding-top: 4rem;
			padding-bottom: 5rem;
		}

		.page-hero,
		.topic-grid {
			grid-template-columns: 1fr;
		}

		.page-hero {
			gap: 2rem;
			padding-bottom: 3rem;
		}

		.page-hero h1 {
			font-size: clamp(4rem, 23vw, 6rem);
		}

		.topic-grid {
			margin-top: 3rem;
		}

		.topic-card {
			min-height: 280px;
		}
	}
</style>
