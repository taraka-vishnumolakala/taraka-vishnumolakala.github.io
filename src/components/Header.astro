---
import HeaderLink from './HeaderLink.astro';
import PageActions from './PageActions.astro';
import { SITE_TITLE } from '../consts';

const pathname = Astro.url.pathname.replace(/\/$/, '');
const postMatch = pathname.match(/^\/blog\/(.+)$/);
const markdownPath = postMatch ? `/blog/${postMatch[1]}.md` : undefined;
---

<header class="site-header">
	<nav class="nav-shell" aria-label="Primary">
		<a href="/" class="brand" aria-label={`${SITE_TITLE}, home`}>
			<span class="brand-mark" aria-hidden="true">TV</span>
			<span class="brand-copy">
				<strong>{SITE_TITLE}</strong>
				<span>Security Architecture</span>
			</span>
		</a>
		<button
			type="button"
			class="nav-toggle"
			aria-label="Toggle navigation menu"
			aria-expanded="false"
			aria-controls="primary-nav"
		>
			<span class="bar"></span>
			<span class="bar"></span>
			<span class="bar"></span>
		</button>
		<div class="nav-links" id="primary-nav">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Writing</HeaderLink>
			<HeaderLink href="/tags">Topics</HeaderLink>
			<a
				href="https://github.com/taraka-vishnumolakala"
				target="_blank"
				rel="noopener noreferrer"
			>
				GitHub <span aria-hidden="true">↗</span>
			</a>
		</div>
	</nav>
</header>
{markdownPath && <PageActions markdownPath={markdownPath} />}

<script>
	const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
	const menu = document.getElementById('primary-nav');
	const header = document.querySelector<HTMLElement>('.site-header');

	if (toggle && menu && header) {
		const close = () => {
			menu.classList.remove('open');
			toggle.classList.remove('open');
			toggle.setAttribute('aria-expanded', 'false');
		};

		toggle.addEventListener('click', () => {
			const isOpen = menu.classList.toggle('open');
			toggle.classList.toggle('open', isOpen);
			toggle.setAttribute('aria-expanded', String(isOpen));
		});

		menu.addEventListener('click', (event) => {
			if ((event.target as HTMLElement).closest('a')) close();
		});

		document.addEventListener('click', (event) => {
			if (!header.contains(event.target as Node)) close();
		});

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape') close();
		});

		const media = window.matchMedia('(min-width: 769px)');
		media.addEventListener('change', (event) => {
			if (event.matches) close();
		});
	}
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 100;
		border-bottom: 1px solid rgba(216, 216, 216, 0.82);
		background: rgba(255, 255, 255, 0.9);
		backdrop-filter: blur(16px);
	}

	.nav-shell {
		width: min(calc(100% - 3rem), var(--container));
		min-height: 72px;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 2rem;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.8rem;
		color: var(--heading);
	}

	.brand:hover .brand-mark {
		background: var(--accent-strong);
		transform: translateY(-1px);
	}

	.brand-mark {
		width: 36px;
		height: 36px;
		display: inline-grid;
		place-items: center;
		border-radius: 5px;
		background: var(--heading);
		color: #fff;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		transition:
			background 0.18s ease,
			transform 0.18s ease;
	}

	.brand-copy {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
		line-height: 1.2;
	}

	.brand-copy strong {
		color: var(--heading);
		font-size: 0.96rem;
		font-weight: 600;
		letter-spacing: -0.015em;
	}

	.brand-copy > span {
		color: var(--text-muted);
		font-family: var(--font-mono);
		font-size: 0.62rem;
		letter-spacing: 0.07em;
		text-transform: uppercase;
	}

	.nav-links {
		display: flex;
		align-items: center;
		gap: 0.25rem;
	}

	.nav-links a {
		position: relative;
		padding: 0.65rem 0.75rem;
		color: var(--text-muted);
		font-size: 0.88rem;
		font-weight: 500;
		line-height: 1;
	}

	.nav-links a::after {
		content: "";
		position: absolute;
		right: 0.75rem;
		bottom: 0.25rem;
		left: 0.75rem;
		height: 1px;
		background: var(--accent);
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.18s ease;
	}

	.nav-links a:hover,
	.nav-links a.active {
		color: var(--heading);
	}

	.nav-links a:hover::after,
	.nav-links a.active::after {
		transform: scaleX(1);
	}

	.nav-toggle {
		position: relative;
		width: 42px;
		height: 42px;
		display: none;
		flex-shrink: 0;
		padding: 0;
		border: 1px solid var(--border);
		border-radius: 6px;
		background: rgba(255, 255, 255, 0.55);
		color: var(--heading);
		cursor: pointer;
	}

	.nav-toggle:hover {
		border-color: var(--accent);
		background: var(--bg-card);
	}

	.nav-toggle .bar {
		position: absolute;
		left: 50%;
		width: 18px;
		height: 1.5px;
		border-radius: 2px;
		background: currentColor;
		transform: translateX(-50%);
		transition:
			transform 0.2s ease,
			opacity 0.2s ease,
			top 0.2s ease;
	}

	.nav-toggle .bar:nth-child(1) {
		top: 14px;
	}

	.nav-toggle .bar:nth-child(2) {
		top: 20px;
	}

	.nav-toggle .bar:nth-child(3) {
		top: 26px;
	}

	.nav-toggle.open .bar:nth-child(1) {
		top: 20px;
		transform: translateX(-50%) rotate(45deg);
	}

	.nav-toggle.open .bar:nth-child(2) {
		opacity: 0;
	}

	.nav-toggle.open .bar:nth-child(3) {
		top: 20px;
		transform: translateX(-50%) rotate(-45deg);
	}

	@media (max-width: 768px) {
		.nav-shell {
			width: min(calc(100% - 2rem), var(--container));
			min-height: 64px;
		}

		.brand-mark {
			width: 34px;
			height: 34px;
		}

		.brand-copy > span {
			display: none;
		}

		.nav-toggle {
			display: block;
		}

		.nav-links {
			position: absolute;
			top: 100%;
			right: 0;
			left: 0;
			display: flex;
			flex-direction: column;
			align-items: stretch;
			gap: 0;
			max-height: 0;
			padding: 0;
			border-bottom: 1px solid var(--border);
			background: rgba(255, 255, 255, 0.98);
			box-shadow: var(--box-shadow-soft);
			opacity: 0;
			overflow: hidden;
			pointer-events: none;
			transition:
				max-height 0.25s ease,
				opacity 0.18s ease,
				padding 0.25s ease;
		}

		.nav-links.open {
			max-height: 320px;
			padding: 0.6rem 1rem 0.85rem;
			opacity: 1;
			pointer-events: auto;
		}

		.nav-links a {
			padding: 0.85rem 0.65rem;
			border-bottom: 1px solid var(--border-soft);
			font-size: 0.95rem;
		}

		.nav-links a:last-child {
			border-bottom: 0;
		}

		.nav-links a::after {
			display: none;
		}

		.nav-links a.active {
			color: var(--accent-strong);
		}
	}
</style>
