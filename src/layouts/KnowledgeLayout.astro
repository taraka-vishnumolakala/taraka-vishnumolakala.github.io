---
import type { KnowledgeCategoryId } from '../content/knowledge-taxonomy';
import { getKnowledgeCategory } from '../content/knowledge-taxonomy';
import type { KnowledgeNote } from '../lib/knowledge';
import FormattedDate from '../components/FormattedDate.astro';
import KnowledgeSidebar from '../components/KnowledgeSidebar.astro';
import SiteLayout from './SiteLayout.astro';

type Props = {
	pageTitle: string;
	title: string;
	description: string;
	notes: KnowledgeNote[];
	activeId?: string;
	category?: KnowledgeCategoryId;
	pubDate?: Date;
	updatedDate?: Date;
	readingTime?: number;
	topics?: string[];
	meta?: string;
};

const {
	pageTitle,
	title,
	description,
	notes,
	activeId,
	category,
	pubDate,
	updatedDate,
	readingTime,
	topics = [],
	meta,
} = Astro.props;

const categoryDetails = category ? getKnowledgeCategory(category) : undefined;
const displayedDate = updatedDate ?? pubDate;
---

<SiteLayout title={pageTitle} description={description}>
	<main class="knowledge-shell">
		<KnowledgeSidebar notes={notes} activeId={activeId} />

		<article class="knowledge-content">
			<header class="knowledge-header">
				<p class="breadcrumb">
					<a href="/">Home</a>
					<span aria-hidden="true">/</span>
					<a href="/knowledge">Knowledge Base</a>
					{categoryDetails && (
						<>
							<span aria-hidden="true">/</span>
							<span>{categoryDetails.label}</span>
						</>
					)}
				</p>
				<p class="eyebrow">
					{categoryDetails?.label ?? 'Learning notes'}
				</p>
				<h1>{title}</h1>
				<p class="knowledge-dek">{description}</p>

				{(displayedDate || readingTime || meta) && (
					<div class="knowledge-meta">
						{displayedDate && (
							<span>
								{updatedDate ? 'Updated' : 'Added'}{' '}
								<FormattedDate date={displayedDate} />
							</span>
						)}
						{readingTime && <span>{readingTime} min read</span>}
						{meta && <span>{meta}</span>}
					</div>
				)}

				{topics.length > 0 && (
					<div class="knowledge-topics" aria-label="Topics">
						{topics.map((topic) => <span>{topic}</span>)}
					</div>
				)}
			</header>

			<div class="knowledge-body">
				<slot />
			</div>
		</article>
	</main>
</SiteLayout>

<style>
	.knowledge-shell {
		width: min(calc(100% - 3rem), 1380px);
		max-width: none;
		display: grid;
		grid-template-columns: minmax(230px, 280px) minmax(0, 900px);
		gap: clamp(2.5rem, 6vw, 5rem);
		justify-content: center;
		align-items: start;
		padding-top: 4.5rem;
		padding-bottom: 7rem;
	}

	.knowledge-content {
		min-width: 0;
	}

	.knowledge-header {
		margin-bottom: 3rem;
		padding-bottom: 2.5rem;
		border-bottom: 1px solid var(--border);
	}

	.breadcrumb {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 0 0 2.25rem;
		color: var(--text-muted);
		font-size: 0.76rem;
	}

	.breadcrumb a:hover {
		color: var(--accent-strong);
	}

	.knowledge-header h1 {
		max-width: 820px;
		margin-bottom: 1.35rem;
		font-size: var(--font-size-page-title);
		line-height: 1.04;
	}

	.knowledge-dek {
		max-width: 720px;
		margin: 0;
		color: var(--text-secondary);
		font-size: 1.08rem;
		line-height: 1.7;
	}

	.knowledge-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem 1.25rem;
		margin-top: 1.65rem;
		color: var(--text-faint);
		font-family: var(--font-mono);
		font-size: 0.62rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.knowledge-topics {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-top: 1.2rem;
	}

	.knowledge-topics span {
		padding: 0.3rem 0.55rem;
		border: 1px solid var(--border);
		border-radius: 999px;
		color: var(--text-muted);
		font-family: var(--font-mono);
		font-size: 0.61rem;
		line-height: 1;
	}

	.knowledge-body {
		min-width: 0;
	}

	@media (max-width: 980px) {
		.knowledge-shell {
			grid-template-columns: minmax(0, 900px);
			gap: 2.5rem;
		}
	}

	@media (max-width: 760px) {
		.knowledge-shell {
			width: min(calc(100% - 2rem), 900px);
			padding-top: 3rem;
			padding-bottom: 5rem;
		}

		.knowledge-header {
			margin-bottom: 2.5rem;
			padding-bottom: 2rem;
		}

		.knowledge-dek {
			font-size: 1rem;
		}
	}
</style>
