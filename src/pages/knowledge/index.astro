---
import KnowledgeCard from '../../components/KnowledgeCard.astro';
import { KNOWLEDGE_CATEGORIES } from '../../content/knowledge-taxonomy';
import { SITE_TITLE } from '../../consts';
import KnowledgeLayout from '../../layouts/KnowledgeLayout.astro';
import {
	getKnowledgeNotes,
	groupKnowledgeNotes,
} from '../../lib/knowledge';

const notes = await getKnowledgeNotes();
const groups = groupKnowledgeNotes(notes);
---

<KnowledgeLayout
	pageTitle={`Knowledge Base — ${SITE_TITLE}`}
	title="Knowledge Base"
	description="Working notes on ML engineering, web application security, and the security testing concepts I want to understand, retain, and revisit."
	{notes}
	meta={`${String(notes.length).padStart(2, '0')} ${notes.length === 1 ? 'note' : 'notes'} · ${String(KNOWLEDGE_CATEGORIES.length).padStart(2, '0')} domains`}
>
	<section class="domain-section" aria-labelledby="domain-heading">
		<div class="section-heading">
			<div>
				<p class="section-label">Domains</p>
				<h2 id="domain-heading">Organized by learning area.</h2>
			</div>
			<p>
				Each note is an MDX page. Notes can remain text-based or include
				interactive explanations when the concept benefits from one.
			</p>
		</div>

		<div class="domain-grid">
			{groups.map((group, index) => {
				const firstNote = group.notes[0];

				return (
					<article class="domain-card">
						<div class="domain-meta">
							<span>{String(index + 1).padStart(2, '0')}</span>
							<span>{group.notes.length} {group.notes.length === 1 ? 'note' : 'notes'}</span>
						</div>
						<h3>{group.label}</h3>
						<p>{group.description}</p>
						{firstNote && (
							<a href={`/knowledge/${firstNote.id}/`}>
								Start with {firstNote.data.title}{' '}
								<span aria-hidden="true">→</span>
							</a>
						)}
					</article>
				);
			})}
		</div>
	</section>

	<section class="notes-section" aria-labelledby="notes-heading">
		<div class="section-heading">
			<div>
				<p class="section-label">All notes</p>
				<h2 id="notes-heading">Current working set.</h2>
			</div>
			<p>
				These notes are intentionally concise and can evolve as my
				understanding changes.
			</p>
		</div>

		<div class="note-grid">
			{notes.map((note) => <KnowledgeCard note={note} />)}
		</div>
	</section>
</KnowledgeLayout>

<style>
	.domain-section,
	.notes-section {
		padding-bottom: 4.5rem;
	}

	.notes-section {
		padding-top: 4.5rem;
		border-top: 1px solid var(--border);
	}

	.section-heading {
		display: grid;
		grid-template-columns: minmax(0, 0.9fr) minmax(280px, 1.1fr);
		gap: 2rem;
		align-items: end;
		margin-bottom: 2rem;
	}

	.section-label {
		margin: 0 0 0.7rem;
		color: var(--accent-strong);
		font-family: var(--font-mono);
		font-size: 0.64rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.section-heading h2 {
		font-size: clamp(1.7rem, 3vw, 2.35rem);
	}

	.section-heading > p {
		margin: 0;
		color: var(--text-secondary);
		font-size: 0.9rem;
		line-height: 1.7;
	}

	.domain-grid,
	.note-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}

	.domain-grid {
		border-top: 1px solid var(--border);
		border-left: 1px solid var(--border);
	}

	.domain-card {
		min-height: 260px;
		display: flex;
		flex-direction: column;
		padding: 1.75rem;
		border-right: 1px solid var(--border);
		border-bottom: 1px solid var(--border);
		background: rgba(255, 255, 255, 0.52);
	}

	.domain-meta {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 2.25rem;
		color: var(--text-faint);
		font-family: var(--font-mono);
		font-size: 0.61rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.domain-meta span:first-child {
		color: var(--accent-strong);
	}

	.domain-card h3 {
		margin-bottom: 0.7rem;
		font-size: 1.28rem;
	}

	.domain-card > p {
		margin: 0 0 1.5rem;
		color: var(--text-secondary);
		font-size: 0.86rem;
		line-height: 1.65;
	}

	.domain-card > a {
		margin-top: auto;
		color: var(--accent-strong);
		font-size: 0.76rem;
		font-weight: 600;
	}

	.domain-card > a:hover {
		color: var(--heading);
		transform: translateX(3px);
	}

	.note-grid {
		gap: 1rem;
	}

	@media (max-width: 720px) {
		.section-heading,
		.domain-grid,
		.note-grid {
			grid-template-columns: 1fr;
		}

		.domain-card {
			min-height: 230px;
		}
	}
</style>
