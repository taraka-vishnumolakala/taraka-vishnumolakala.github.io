---
import HeaderLink from './HeaderLink.astro';
import PageActions from './PageActions.astro';
import { SITE_TITLE } from '../consts';
import { BLOG_TAGS, TAG_LABELS, type BlogTag } from '../content/taxonomy';

type Props = {
	showPageActions?: boolean;
	activeTopic?: BlogTag;
};

const { showPageActions = true, activeTopic } = Astro.props;
const pathname = Astro.url.pathname.replace(/\/$/, '');
const isArticlesPage = /^\/(blog|tags)(\/|$)/.test(pathname);
const contentMatch = pathname.match(/^\/(blog|knowledge)\/(.+)$/);
const markdownPath = contentMatch
	? `/${contentMatch[1]}/${contentMatch[2]}.md`
	: undefined;
---

<header class="site-header">
	<nav class="nav-shell" aria-label="Primary">
		<a href="/" class="brand" aria-label={`${SITE_TITLE}, home`}>
			<span class="brand-mark" aria-hidden="true">TV</span>
			<span class="brand-copy">
				<strong>{SITE_TITLE}</strong>
				<span>Security Architecture</span>
			</span>
		</a>
		<button
			type="button"
			class="nav-toggle"
			aria-label="Toggle navigation menu"
			aria-expanded="false"
			aria-controls="primary-nav"
		>
			<span class="bar"></span>
			<span class="bar"></span>
			<span class="bar"></span>
		</button>
		<div class="nav-links" id="primary-nav">
			<HeaderLink href="/">Home</HeaderLink>
			<div class="topic-dropdown" data-topic-dropdown>
				<button
					type="button"
					class:list={['topic-dropdown-toggle', { active: isArticlesPage }]}
					aria-expanded="false"
					aria-controls="article-options"
					data-topic-toggle
				>
					Articles
					<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
						<path d="m4 6 4 4 4-4"></path>
					</svg>
				</button>
				<div class="article-options" id="article-options" hidden>
					<HeaderLink href="/blog/">All articles</HeaderLink>
					<div class="topic-links">
						{BLOG_TAGS.map((tag) => (
							<HeaderLink
								href={`/tags/${tag}/`}
								active={activeTopic ? activeTopic === tag : undefined}
							>
								{TAG_LABELS[tag]}
							</HeaderLink>
						))}
					</div>
				</div>
			</div>
			<HeaderLink href="/tags/">Tags</HeaderLink>
			<a
				href="https://github.com/taraka-vishnumolakala"
				target="_blank"
				rel="noopener noreferrer"
			>
				GitHub <span aria-hidden="true">↗</span>
			</a>
		</div>
	</nav>
</header>
{showPageActions && markdownPath && <PageActions markdownPath={markdownPath} />}

<script>
	const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
	const menu = document.getElementById('primary-nav');
	const header = document.querySelector<HTMLElement>('.site-header');
	const topicDropdown = document.querySelector<HTMLElement>('[data-topic-dropdown]');
	const topicToggle = document.querySelector<HTMLButtonElement>('[data-topic-toggle]');
	const topicOptions = document.getElementById('article-options');
	const closeTopics = () => {
		if (!topicToggle || !topicOptions) return;
		topicOptions.hidden = true;
		topicToggle.setAttribute('aria-expanded', 'false');
	};

	if (topicDropdown && topicToggle && topicOptions) {
		const hoverNavigation = window.matchMedia('(hover: hover) and (pointer: fine)');
		let openedByPointer = false;
		const openTopics = () => {
			topicOptions.hidden = false;
			topicToggle.setAttribute('aria-expanded', 'true');
		};
		topicToggle.addEventListener('pointerenter', (event) => {
			if (event.pointerType === 'mouse' && hoverNavigation.matches) {
				openedByPointer = true;
				openTopics();
			}
		});
		topicDropdown.addEventListener('pointerleave', () => {
			if (openedByPointer) closeTopics();
		});
		topicDropdown.addEventListener('keydown', () => {
			openedByPointer = false;
		});
		topicToggle.addEventListener('click', (event) => {
			openedByPointer = event.detail > 0 && hoverNavigation.matches;
			if (openedByPointer || topicOptions.hidden) openTopics();
			else closeTopics();
		});
		topicToggle.addEventListener('keydown', (event) => {
			if (event.key === 'ArrowDown') {
				event.preventDefault();
				openTopics();
				topicOptions.querySelector<HTMLAnchorElement>('a')?.focus();
			}
		});
		document.addEventListener('click', (event) => {
			if (!topicDropdown.contains(event.target as Node)) closeTopics();
		});
		topicDropdown.addEventListener('focusout', (event) => {
			if (!topicDropdown.contains(event.relatedTarget as Node | null)) closeTopics();
		});
	}

	if (toggle && menu && header) {
		const close = () => {
			closeTopics();
			menu.classList.remove('open');
			toggle.classList.remove('open');
			toggle.setAttribute('aria-expanded', 'false');
		};

		toggle.addEventListener('click', () => {
			const isOpen = menu.classList.toggle('open');
			toggle.classList.toggle('open', isOpen);
			toggle.setAttribute('aria-expanded', String(isOpen));
		});

		menu.addEventListener('click', (event) => {
			if ((event.target as HTMLElement).closest('a')) close();
		});

		document.addEventListener('click', (event) => {
			if (!header.contains(event.target as Node)) close();
		});

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && topicOptions && !topicOptions.hidden) {
				closeTopics();
				topicToggle?.focus();
			} else if (event.key === 'Escape' && menu.classList.contains('open')) {
				close();
				toggle.focus();
			}
		});

		const media = window.matchMedia('(min-width: 769px)');
		media.addEventListener('change', (event) => {
			if (event.matches) close();
		});
	}
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 100;
		border-bottom: 1px solid var(--border);
		background: var(--bg);
	}

	.nav-shell {
		width: min(calc(100% - 3rem), var(--container));
		min-height: 72px;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 2rem;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.8rem;
		color: var(--heading);
	}

	.brand:hover .brand-mark {
		background: var(--accent-strong);
		box-shadow: 3px 3px 0 var(--text-faint);
		transform: translate(-1px, -1px);
	}

	.brand-mark {
		width: 36px;
		height: 36px;
		display: inline-grid;
		place-items: center;
		border: 1px solid var(--heading);
		border-radius: 4px;
		background: var(--heading);
		box-shadow: 2px 2px 0 var(--text-faint);
		color: #fff;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		transition:
			background 0.18s ease,
			box-shadow 0.18s ease,
			transform 0.18s ease;
	}

	.brand-copy {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
		line-height: 1.2;
	}

	.brand-copy strong {
		color: var(--heading);
		font-size: 0.96rem;
		font-weight: 600;
		letter-spacing: -0.015em;
	}

	.brand-copy > span {
		color: var(--text-muted);
		font-family: var(--font-mono);
		font-size: 0.62rem;
		letter-spacing: 0.07em;
		text-transform: uppercase;
	}

	.nav-links {
		display: flex;
		align-items: center;
		gap: 0.25rem;
	}

	.topic-dropdown {
		position: relative;
	}

	.topic-dropdown-toggle {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		border: 0;
		background: transparent;
		cursor: pointer;
	}

	.topic-dropdown-toggle svg {
		width: 14px;
		height: 14px;
		transition: transform 0.18s ease;
	}

	.topic-dropdown-toggle[aria-expanded="true"] svg {
		transform: rotate(180deg);
	}

	.nav-links a,
	.topic-dropdown-toggle {
		position: relative;
		padding: 0.65rem 0.75rem;
		color: var(--text-muted);
		font-size: 0.88rem;
		font-weight: 500;
		line-height: 1.35;
	}

	.nav-links a::after,
	.topic-dropdown-toggle::after {
		content: "";
		position: absolute;
		right: 0.75rem;
		bottom: 0.25rem;
		left: 0.75rem;
		height: 2px;
		background: var(--accent);
		clip-path: polygon(0 35%, 100% 0, 91% 100%, 4% 70%);
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.18s ease;
	}

	.nav-links a:hover,
	.nav-links a.active,
	.topic-dropdown-toggle:hover,
	.topic-dropdown-toggle.active,
	.topic-dropdown-toggle[aria-expanded="true"] {
		color: var(--heading);
	}

	.nav-links a:hover::after,
	.nav-links a.active::after,
	.topic-dropdown-toggle:hover::after,
	.topic-dropdown-toggle.active::after,
	.topic-dropdown-toggle[aria-expanded="true"]::after {
		transform: scaleX(1);
	}

	.article-options {
		position: absolute;
		top: 100%;
		right: 0;
		width: min(350px, calc(100vw - 2rem));
		padding: 0.5rem;
		border: 1px solid var(--text-faint);
		border-radius: var(--panel-radius);
		background: var(--bg-card);
		box-shadow: var(--ink-shadow-control);
	}

	.article-options a {
		display: block;
		padding: 0.75rem;
		border-radius: 4px;
		line-height: 1.45;
	}

	.article-options a::after {
		display: none;
	}

	.article-options a:hover,
	.article-options a.active {
		background: var(--accent-faint);
	}

	.topic-links {
		margin-top: 0.35rem;
		padding-top: 0.35rem;
		border-top: 1px solid var(--border-soft);
	}

	.nav-toggle {
		position: relative;
		width: 42px;
		height: 42px;
		display: none;
		flex-shrink: 0;
		padding: 0;
		border: 2px solid var(--text-muted);
		border-radius: var(--panel-radius);
		background: var(--bg-card);
		box-shadow: var(--ink-shadow-control);
		color: var(--heading);
		cursor: pointer;
	}

	.nav-toggle:hover {
		border-color: var(--accent);
		background: var(--bg-card);
	}

	.nav-toggle .bar {
		position: absolute;
		left: 50%;
		width: 18px;
		height: 1.5px;
		border-radius: 2px;
		background: currentColor;
		transform: translateX(-50%);
		transition:
			transform 0.2s ease,
			opacity 0.2s ease,
			top 0.2s ease;
	}

	.nav-toggle .bar:nth-child(1) {
		top: 14px;
	}

	.nav-toggle .bar:nth-child(2) {
		top: 20px;
	}

	.nav-toggle .bar:nth-child(3) {
		top: 26px;
	}

	.nav-toggle.open .bar:nth-child(1) {
		top: 20px;
		transform: translateX(-50%) rotate(45deg);
	}

	.nav-toggle.open .bar:nth-child(2) {
		opacity: 0;
	}

	.nav-toggle.open .bar:nth-child(3) {
		top: 20px;
		transform: translateX(-50%) rotate(-45deg);
	}

	@media (max-width: 768px) {
		.nav-shell {
			width: min(calc(100% - 2rem), var(--container));
			min-height: 64px;
		}

		.brand-mark {
			width: 34px;
			height: 34px;
		}

		.brand-copy > span {
			display: none;
		}

		.nav-toggle {
			display: block;
		}

		.nav-links {
			position: absolute;
			top: 100%;
			right: 0;
			left: 0;
			display: flex;
			flex-direction: column;
			align-items: stretch;
			gap: 0;
			max-height: 0;
			padding: 0;
			border-bottom: 1px solid var(--border);
			background: var(--bg-card);
			box-shadow: var(--box-shadow-soft);
			opacity: 0;
			visibility: hidden;
			overflow: hidden;
			pointer-events: none;
			transition:
				max-height 0.25s ease,
				opacity 0.18s ease,
				padding 0.25s ease;
		}

		.nav-links.open {
			max-height: calc(100dvh - 64px);
			padding: 0.6rem 1rem 0.85rem;
			opacity: 1;
			visibility: visible;
			overflow-y: auto;
			pointer-events: auto;
		}

		.topic-dropdown-toggle {
			width: 100%;
			justify-content: space-between;
		}

		.article-options {
			position: static;
			width: auto;
			margin: 0 0 0.5rem 0.65rem;
			padding: 0.25rem 0.5rem;
			border: 0;
			border-left: 2px solid var(--border);
			border-radius: 0;
			box-shadow: none;
		}

		.nav-links a,
		.topic-dropdown-toggle {
			padding: 0.85rem 0.65rem;
			border-bottom: 1px solid var(--border-soft);
			font-size: 0.95rem;
		}

		.nav-links a:last-child {
			border-bottom: 0;
		}

		.nav-links a::after,
		.topic-dropdown-toggle::after {
			display: none;
		}

		.nav-links a.active {
			color: var(--accent-strong);
		}
	}
</style>
