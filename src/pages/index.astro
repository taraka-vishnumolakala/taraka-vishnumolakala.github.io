---
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import FaviconMark from '../components/FaviconMark.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
		<main class="home-main">
			<section class="hero" id="about">
				<div class="hero-copy">
					<p class="eyebrow">Software engineering · Security engineering</p>
					<h1>Software engineer turned security engineer.</h1>
					<p class="hero-lede">
						I’m Taraka Vishnumolakala. I currently focus on Agentic and ML
						Security, with broader experience in security system design,
						application and API security, cloud security, threat modeling,
						and offensive security.
					</p>
					<div class="role-lockup">
						<FaviconMark
							src="https://www.workday.com/favicon.ico"
							fallback="W"
							loading="eager"
						/>
						<p class="role">
							Sr. Cybersecurity Engineer, Security Architecture at
							<a
								href="https://www.workday.com"
								target="_blank"
								rel="noopener noreferrer">Workday, Inc ↗</a
							>
							<span class="role-location"
								>Washington, D.C.–Baltimore Area</span
							>
						</p>
					</div>
					<div class="hero-actions">
						<a class="button button-primary" href="#experience">
							View experience <span aria-hidden="true">→</span>
						</a>
						<a
							class="button button-secondary"
							href="https://github.com/taraka-vishnumolakala"
							target="_blank"
							rel="noopener noreferrer"
						>
							View GitHub <span aria-hidden="true">↗</span>
						</a>
					</div>
				</div>
				<aside class="profile-card" aria-label="About Taraka Vishnumolakala">
					<div class="portrait-frame">
						<div class="portrait-accent" aria-hidden="true"></div>
						<img
							src="/taraka.png"
							alt="Taraka Vishnumolakala"
							width="3099"
							height="3899"
							fetchpriority="high"
						/>
					</div>
				</aside>
			</section>

			<section class="expertise-section" aria-labelledby="expertise-heading">
				<h2 id="expertise-heading">Areas of expertise</h2>
				<ul class="expertise-strip">
					<li>
						<span class="expertise-number">01</span>
						<strong>Agentic & ML Security</strong>
						<p>
							Securing products built with AI and agentic capabilities,
							managing ML model risks, and implementing enterprise controls
							across agent identity, MCP, A2A, and A2UI.
						</p>
					</li>
					<li>
						<span class="expertise-number">02</span>
						<strong>Application & API Security</strong>
						<p>Product attack surfaces, secure design, and defense-in-depth.</p>
					</li>
					<li>
						<span class="expertise-number">03</span>
						<strong>Cloud Security</strong>
						<p>Secure cloud architecture, identity, trust boundaries, and platform risk.</p>
					</li>
					<li>
						<span class="expertise-number">04</span>
						<strong>Threat Modeling & Culture</strong>
						<p>
							Collaborative threat modeling with engineers, leading Security
							Champions programs, and communicating security progress and risk
							to leadership.
						</p>
					</li>
				</ul>
			</section>

			<section class="experience-section" id="experience">
				<div class="section-intro">
					<div>
						<p class="eyebrow">Experience</p>
						<h2>From software engineering to security architecture.</h2>
					</div>
					<p>
						Roles spanning security architecture, application security, and
						software engineering since 2018.
					</p>
				</div>

				<ol class="career-timeline" aria-label="Professional experience">
						<li class="timeline-item is-current" data-timeline-item>
							<div class="timeline-period">
								<time datetime="2023-09">Sep 2023 — Present</time>
								<span class="timeline-location"
									>Washington, D.C.–Baltimore Area</span
								>
							</div>
							<span class="timeline-marker" aria-hidden="true"></span>
							<article class="timeline-entry">
								<a
									class="timeline-company"
									href="https://www.workday.com/"
									target="_blank"
									rel="noopener noreferrer"
								>
									<FaviconMark
										src="https://www.workday.com/favicon.ico"
										fallback="W"
										size="compact"
									/>
									<span>Workday, Inc.</span>
								</a>
								<h3>Senior Cybersecurity Engineer, Security Architecture</h3>
								<p>
									Security architecture, threat modeling, and secure-design
									guidance across product, cloud, ML, and agentic systems,
									including M&A security due diligence and secure integration
									reviews.
								</p>
							</article>
						</li>
						<li class="timeline-item" data-timeline-item>
							<div class="timeline-period">
								<time datetime="2022-08">Aug 2022 — Sep 2023</time>
								<span class="timeline-location">Dallas, TX</span>
							</div>
							<span class="timeline-marker" aria-hidden="true"></span>
							<article class="timeline-entry">
								<a
									class="timeline-company"
									href="https://www.goodleap.com/"
									target="_blank"
									rel="noopener noreferrer"
								>
									<FaviconMark
										src="https://www.google.com/s2/favicons?domain_url=https%3A%2F%2Fwww.goodleap.com%2F&sz=128"
										fallback="G"
										size="compact"
									/>
									<span>GoodLeap, LLC</span>
								</a>
								<h3>Application Security Engineer</h3>
								<p>
									Application and API security, white-box testing, secure
									code review, cloud security, and Security Champions
									program leadership.
								</p>
							</article>
						</li>
						<li class="timeline-item" data-timeline-item>
							<div class="timeline-period">
								<time datetime="2021-05">May 2021 — Aug 2022</time>
								<span class="timeline-location">Omaha, NE</span>
							</div>
							<span class="timeline-marker" aria-hidden="true"></span>
							<article class="timeline-entry">
								<a
									class="timeline-company"
									href="https://www.essvote.com/"
									target="_blank"
									rel="noopener noreferrer"
								>
									<FaviconMark
										src="https://www.essvote.com/storage/2018/10/cropped-favicon-192x192.png"
										fallback="E"
										size="compact"
									/>
									<span>Election Systems & Software</span>
								</a>
								<h3>Application Security Engineer</h3>
								<p>
									Product security strategy, Secure SDLC, vulnerability
									management, security architecture, cryptography, and
									infrastructure hardening for voting systems.
								</p>
							</article>
						</li>
						<li class="timeline-item" data-timeline-item>
							<div class="timeline-period">
								<time datetime="2019-01">Jan 2019 — May 2021</time>
								<span class="timeline-location">Omaha, NE</span>
							</div>
							<span class="timeline-marker" aria-hidden="true"></span>
							<article class="timeline-entry">
								<a
									class="timeline-company"
									href="https://www.essvote.com/"
									target="_blank"
									rel="noopener noreferrer"
								>
									<FaviconMark
										src="https://www.essvote.com/storage/2018/10/cropped-favicon-192x192.png"
										fallback="E"
										size="compact"
									/>
									<span>Election Systems & Software</span>
								</a>
								<h3>Software Engineer, Security</h3>
								<p>
									Built and optimized mission-critical election software,
									data-processing workflows, and cryptographic integrations.
								</p>
							</article>
						</li>
						<li class="timeline-item" data-timeline-item>
							<div class="timeline-period">
								<time datetime="2018-05">May 2018 — Dec 2018</time>
								<span class="timeline-location">Omaha, NE</span>
							</div>
							<span class="timeline-marker" aria-hidden="true"></span>
							<article class="timeline-entry">
								<a
									class="timeline-company"
									href="https://www.essvote.com/"
									target="_blank"
									rel="noopener noreferrer"
								>
									<FaviconMark
										src="https://www.essvote.com/storage/2018/10/cropped-favicon-192x192.png"
										fallback="E"
										size="compact"
									/>
									<span>Election Systems & Software</span>
								</a>
								<h3>Software Engineer Intern</h3>
								<p>
									Developed Java applications and database-migration tooling
									for election systems.
								</p>
							</article>
						</li>
				</ol>
			</section>

			<section class="approach-section">
				<div class="approach-heading">
					<p class="eyebrow">How I work</p>
					<h2>A practical approach to security architecture.</h2>
					<p>
						I start with system context, identify credible failure paths, and
						work with engineering teams on controls that can be implemented
						and maintained.
					</p>
				</div>
				<div class="approach-grid">
					<article>
						<span>01 / Understand context</span>
						<h3>Map the system and its trust boundaries.</h3>
						<p>
							Review architecture, identities, data flows, dependencies,
							and operational constraints before assessing risk.
						</p>
					</article>
					<article>
						<span>02 / Assess risk</span>
						<h3>Prioritize credible attack paths.</h3>
						<p>
							Use threat modeling, code review, and offensive testing to
							connect design decisions to realistic impact.
						</p>
					</article>
					<article>
						<span>03 / Define controls</span>
						<h3>Turn findings into engineering decisions.</h3>
						<p>
							Recommend specific controls, owners, and verification steps,
							then integrate them into design reviews and development
							workflows.
						</p>
					</article>
				</div>
			</section>

			<section class="background-section">
				<div class="background-heading">
					<p class="eyebrow">Background</p>
					<h2>Education, speaking, and credentials.</h2>
				</div>
				<div class="background-grid">
					<article class="background-card education-card">
						<header class="background-card-header">
							<span>Education</span>
							<span>02 degrees</span>
						</header>
						<div class="degree">
							<time datetime="2019">2019</time>
							<div>
								<h3>Master’s in Cybersecurity</h3>
								<p>University of Nebraska at Omaha</p>
							</div>
						</div>
						<div class="degree">
							<time datetime="2016">2016</time>
							<div>
								<h3>B.E. in Electronics and Communication</h3>
								<p>Andhra University</p>
							</div>
						</div>
					</article>
					<article class="background-card speaking-card">
						<header class="background-card-header">
							<span>Conference speaking</span>
							<span>2025</span>
						</header>
						<a
							class="speaking-link"
							href="https://www.threatmodcon.com/agenda/threat-modeling-as-a-team-sport-with-security-champions-ai"
							target="_blank"
							rel="noopener noreferrer"
						>
							<span class="speaking-event">ThreatModCon</span>
							<h3>
								Threat Modeling as a Team Sport with Security Champions & AI
							</h3>
							<p>International threat modeling conference</p>
							<strong>View session <span aria-hidden="true">↗</span></strong>
						</a>
					</article>
					<article class="background-card certifications-card">
						<header class="background-card-header">
							<span>Certifications</span>
							<span>Verified credentials</span>
						</header>
						<div class="certification-grid">
							<a
								class="certification"
								href="https://www.credly.com/badges/d4d2b1e0-2762-44e9-935f-44328fbf9a7a"
								target="_blank"
								rel="noopener noreferrer"
							>
								<span>ISC2</span>
								<strong>CISSP</strong>
								<small>View credential ↗</small>
							</a>
							<a
								class="certification"
								href="https://training.hacktricks.xyz/certificates/d2f8036c-ab36-4b5f-b73c-a11198d70646"
								target="_blank"
								rel="noopener noreferrer"
							>
								<span>HackTricks Training</span>
								<strong>AWS Red Team Expert</strong>
								<small>View credential ↗</small>
							</a>
							<a
								class="certification"
								href="https://www.credential.net/b3fad3f4-0100-46c3-9383-dc0f6e2e91b3#acc.3gS7TmCe"
								target="_blank"
								rel="noopener noreferrer"
							>
								<span>Pentester Academy</span>
								<strong>Web Application Security Professional</strong>
								<small>View credential ↗</small>
							</a>
						</div>
					</article>
				</div>
			</section>

			<section class="connect-section">
				<div>
					<p class="eyebrow">Connect</p>
					<h2>Code, projects, and professional updates.</h2>
				</div>
				<div class="connect-links">
					<a
						href="https://github.com/taraka-vishnumolakala"
						target="_blank"
						rel="noopener noreferrer"
					>
						<span>Code and open-source work</span>
						<strong>GitHub ↗</strong>
					</a>
					<a
						href="https://www.linkedin.com/in/tvishnumolakala/"
						target="_blank"
						rel="noopener noreferrer"
					>
						<span>Social media profile</span>
						<strong>LinkedIn ↗</strong>
					</a>
				</div>
			</section>
		</main>
		<script slot="body-end">
			const timelineItems = Array.from(
				document.querySelectorAll('[data-timeline-item]'),
			);
			const reducedMotion = window.matchMedia(
				'(prefers-reduced-motion: reduce)',
			).matches;

			if ('IntersectionObserver' in window && !reducedMotion) {
				timelineItems.forEach((item) =>
					item.classList.add('timeline-reveal-pending'),
				);
				const observer = new IntersectionObserver(
					(entries) => {
						entries.forEach((entry) => {
							if (!entry.isIntersecting) return;
							entry.target.classList.add('is-visible');
							observer.unobserve(entry.target);
						});
					},
					{ rootMargin: '0px 0px -4% 0px', threshold: 0.01 },
				);

				timelineItems.forEach((item) => observer.observe(item));
			} else {
				timelineItems.forEach((item) => item.classList.add('is-visible'));
			}
		</script>
</SiteLayout>

<style>
	.home-main {
		padding-top: 4.5rem;
		padding-bottom: 7rem;
	}

	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1.25fr) minmax(330px, 0.75fr);
		gap: clamp(3rem, 8vw, 7.5rem);
		align-items: center;
		min-height: calc(100vh - 10rem);
		padding-bottom: 5rem;
	}

	.hero-copy h1 {
		max-width: 820px;
		margin-bottom: 1.5rem;
		font-size: var(--font-size-page-title);
	}

	.hero .eyebrow::before,
	.experience-section .eyebrow::before,
	.approach-section .eyebrow::before,
	.connect-section .eyebrow::before {
		width: 2rem;
		height: 3px;
		clip-path: polygon(0 38%, 100% 0, 88% 100%, 0 68%);
	}

	.hero-lede {
		max-width: 700px;
		margin: 0 0 1.3rem;
		color: var(--text-secondary);
		font-size: clamp(1.08rem, 2vw, 1.32rem);
		line-height: 1.65;
	}

	.role-lockup {
		display: flex;
		align-items: flex-start;
		gap: 0.75rem;
		margin-bottom: 2rem;
	}

	.role {
		margin: 0;
		color: var(--text-muted);
		font-size: 0.92rem;
	}

	.role a {
		color: var(--accent-strong);
		font-weight: 600;
	}

	.role a:hover {
		color: var(--heading);
	}

	.role-location {
		display: block;
		margin-top: 0.2rem;
		color: var(--text-faint);
		font-size: 0.78rem;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.hero-actions .button {
		border-width: 2px;
	}

	.hero-actions .button-primary {
		box-shadow:
			3px 3px 0 var(--text-faint),
			0 8px 18px rgb(0 0 0 / 12%);
	}

	.hero-actions .button-secondary {
		border-color: var(--text-muted);
		box-shadow: 3px 3px 0 var(--accent-soft);
	}

	.hero-actions .button:hover {
		transform: translate(-1px, -2px);
	}

	.hero-actions .button:active {
		box-shadow: none;
		transform: translate(2px, 2px);
	}

	.profile-card {
		position: relative;
		isolation: isolate;
		max-width: 410px;
		justify-self: end;
	}

	.profile-card::before,
	.profile-card::after {
		content: "";
		position: absolute;
		z-index: 0;
		pointer-events: none;
	}

	.profile-card::before {
		top: -2rem;
		right: -2.2rem;
		width: 10rem;
		height: 10rem;
		background-image: radial-gradient(
			circle,
			rgb(17 17 17 / 42%) 0 1px,
			transparent 1.3px
		);
		background-size: 8px 8px;
		opacity: 0.38;
		transform: rotate(4deg);
		mask-image: linear-gradient(135deg, #000 8%, transparent 76%);
	}

	.profile-card::after {
		top: 12%;
		left: -2.4rem;
		width: 3.5rem;
		height: 45%;
		background: repeating-linear-gradient(
			165deg,
			transparent 0 9px,
			rgb(17 17 17 / 38%) 10px 11px,
			transparent 12px 18px
		);
		clip-path: polygon(100% 0, 100% 100%, 0 74%, 45% 50%, 0 26%);
		opacity: 0.55;
	}

	.portrait-frame {
		position: relative;
		z-index: 1;
		padding: 0 0.9rem 0.9rem 0;
	}

	.portrait-frame img {
		position: relative;
		z-index: 2;
		display: block;
		width: 100%;
		aspect-ratio: 4 / 5;
		border: 2px solid var(--heading);
		border-radius: 7px;
		object-fit: cover;
		box-shadow:
			3px 3px 0 var(--bg-card),
			5px 5px 0 var(--heading),
			var(--box-shadow);
	}

	.portrait-accent {
		position: absolute;
		z-index: 1;
		right: 0;
		bottom: 0;
		width: 72%;
		height: 74%;
		border: 1px solid var(--heading);
		border-radius: 7px;
		background:
			linear-gradient(rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.08)),
			var(--accent);
		transform: skew(-1deg, -1deg);
	}

	.expertise-section h2 {
		margin-bottom: 1.75rem;
	}

	.expertise-strip {
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		border-top: 1px solid var(--border);
		border-bottom: 1px solid var(--border);
		list-style: none;
	}

	.expertise-strip li {
		position: relative;
		min-height: 180px;
		overflow: hidden;
		padding: 1.75rem 1.5rem;
		border-right: 1px solid var(--border);
	}

	.expertise-strip li::after {
		content: "";
		position: absolute;
		top: 0.85rem;
		right: 0.85rem;
		width: 3rem;
		height: 3rem;
		background-image: radial-gradient(
			circle,
			var(--text-faint) 0 0.75px,
			transparent 1px
		);
		background-size: 6px 6px;
		clip-path: polygon(36% 0, 100% 0, 100% 64%);
		opacity: 0.18;
		pointer-events: none;
	}

	.expertise-strip li:first-child {
		padding-left: 0;
	}

	.expertise-strip li:last-child {
		padding-right: 0;
		border-right: 0;
	}

	.expertise-number {
		display: block;
		margin-bottom: 1.7rem;
		color: var(--accent);
		font-family: var(--font-mono);
		font-size: 0.66rem;
	}

	.expertise-strip strong {
		display: block;
		margin-bottom: 0.45rem;
		color: var(--heading);
		font-size: 0.95rem;
	}

	.expertise-strip p {
		margin: 0;
		color: var(--text-muted);
		font-size: 0.8rem;
		line-height: 1.55;
	}

	.experience-section,
	.approach-section {
		padding: 7.5rem 0;
		border-bottom: 1px solid var(--border);
	}

	.section-intro {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(320px, 0.55fr);
		align-items: end;
		gap: clamp(3rem, 8vw, 7rem);
		margin-bottom: 3.5rem;
	}

	.section-intro > div {
		max-width: 720px;
	}

	.section-intro > p {
		max-width: 520px;
		margin: 0;
		color: var(--text-secondary);
		line-height: 1.75;
	}

	.career-timeline {
		position: relative;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.career-timeline::before {
		content: "";
		position: absolute;
		top: 0.6rem;
		bottom: 0;
		left: 180px;
		width: 1px;
		background: var(--border);
	}

	.timeline-item {
		position: relative;
		display: grid;
		grid-template-columns: 160px 40px minmax(0, 1fr);
		align-items: start;
	}

	.timeline-period {
		margin: 0;
		padding-top: 0.1rem;
		color: var(--text-muted);
		font-family: var(--font-mono);
		font-size: 0.67rem;
		line-height: 1.5;
		text-align: right;
		text-transform: uppercase;
	}

	.timeline-location {
		display: block;
		margin-top: 0.35rem;
		color: var(--text-faint);
		letter-spacing: 0;
		line-height: 1.4;
		text-transform: none;
	}

	.timeline-marker {
		position: relative;
		z-index: 1;
		width: 11px;
		height: 11px;
		margin-top: 0.35rem;
		justify-self: center;
		border: 2px solid var(--bg-card);
