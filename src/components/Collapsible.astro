---
interface Props {
	title: string;
	open?: boolean;
}

const { title, open = false } = Astro.props;
---

<details class="collapsible" open={open}>
	<summary>{title}</summary>
	<div class="collapsible-body">
		<slot />
	</div>
</details>

<style>
	.collapsible {
		background-color: var(--accent-faint);
		border: 1px solid var(--text-faint);
		border-radius: var(--panel-radius);
		box-shadow: var(--ink-shadow-flat);
		margin: 2em 0;
		overflow: hidden;
	}

	.collapsible > summary {
		padding: 0.85em 1em;
		font-family: var(--font-sans);
		font-size: 0.88em;
		font-weight: 600;
		color: var(--bold);
		cursor: pointer;
		list-style: none;
		user-select: none;
		display: flex;
		align-items: center;
		gap: 0.55em;
	}

	.collapsible > summary::-webkit-details-marker {
		display: none;
	}

	.collapsible > summary::before {
		content: "+";
		display: inline-block;
		color: var(--accent);
		font-family: var(--font-mono);
		font-size: 1em;
	}

	.collapsible[open] > summary::before {
		content: "−";
	}

	.collapsible > summary:hover {
		color: var(--heading);
	}

	.collapsible-body {
		padding: 0.35em 1em 0.85em;
		border-top: 1px solid var(--bg-code-border);
		background-color: var(--bg-card);
	}

	.collapsible-body :global(pre) {
		margin: 1em 0;
		box-shadow: none;
	}

	.collapsible-body :global(pre:first-child) {
		margin-top: 0.75em;
	}

	.collapsible-body :global(pre:last-child) {
		margin-bottom: 0.5em;
	}

	.collapsible-body :global(p) {
		margin: 0.75em 0;
	}

	.collapsible-body :global(p:first-child) {
		margin-top: 0.5em;
	}
</style>
