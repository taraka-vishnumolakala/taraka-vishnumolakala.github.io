---
import { formatTag } from '../lib/blog';

type Props = {
	tag: string;
};

const { tag } = Astro.props;
---

<a class="tag" href={`/tags/${tag}/`}>{formatTag(tag)}</a>

<style>
	.tag {
		line-height: 1.4;
	}

	.tag:hover {
		border-color: var(--accent);
		color: var(--accent-strong);
	}
</style>
