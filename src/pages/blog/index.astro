---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const EXCERPT_LENGTH = 180;

function buildExcerpt(body: string | undefined): string {
	if (!body) return '';
	const plain = body
		.replace(/^---[\s\S]*?---/, '')
		.replace(/```[\s\S]*?```/g, '')
		.replace(/`[^`]*`/g, '')
		.replace(/!\[[^\]]*\]\([^)]*\)/g, '')
		.replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')
		.replace(/^#{1,6}\s+/gm, '')
		.replace(/^\s*[-*+]\s+/gm, '')
		.replace(/^\s*>\s?/gm, '')
		.replace(/[*_~]+/g, '')
		.replace(/-{2,}/g, ' ')
		.replace(/\s+/g, ' ')
		.trim();
	if (plain.length <= EXCERPT_LENGTH) return plain;
	const cut = plain.slice(0, EXCERPT_LENGTH);
	const lastSpace = cut.lastIndexOf(' ');
	return `${cut.slice(0, lastSpace > 0 ? lastSpace : EXCERPT_LENGTH).trimEnd()}...`;
}

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.map((post) => ({
		...post,
		excerpt: buildExcerpt(post.body),
	}));
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Blog — ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			.posts {
				list-style: none;
				margin: 0;
				padding: 0;
				display: grid;
				gap: 1.25rem;
			}

			.card {
				position: relative;
				border: 1px solid var(--border);
				border-radius: 8px;
				background: var(--bg-card);
				overflow: hidden;
				transition:
					transform 0.18s ease,
					box-shadow 0.18s ease,
					border-color 0.18s ease;
			}

			.card::before {
				content: '';
				position: absolute;
				left: 0;
				top: 0;
				bottom: 0;
				width: 3px;
				background: var(--accent);
				opacity: 0;
				transition: opacity 0.18s ease;
			}

			.card:hover,
			.card:focus-within {
				transform: translateY(-2px);
				border-color: var(--accent-soft);
				box-shadow:
					0 1px 2px rgba(0, 0, 0, 0.04),
					0 8px 24px rgba(46, 123, 207, 0.08);
			}

			.card:hover::before,
			.card:focus-within::before {
				opacity: 1;
			}

			.card-link {
				display: block;
				padding: 1.5rem 1.5rem 1.25rem 1.75rem;
				color: var(--text);
				text-decoration: none;
			}

			.card-link:hover,
			.card-link:focus {
				text-decoration: none;
				color: var(--text);
			}

			.card-link:focus-visible {
				outline: 2px solid var(--accent);
				outline-offset: 2px;
				border-radius: 8px;
			}

			.title {
				font-size: 1.4rem;
				font-weight: 600;
				color: var(--heading);
				line-height: 1.3;
				margin: 0 0 0.6rem 0;
				transition: color 0.15s ease;
			}

			.card:hover .title,
			.card:focus-within .title {
				color: var(--accent-dim);
			}

			.excerpt {
				font-size: 0.95rem;
				color: var(--text);
				line-height: 1.6;
				margin: 0 0 1.1rem 0;
				display: -webkit-box;
				-webkit-line-clamp: 3;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}

			.footer-row {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 1rem;
			}

			.date {
				font-size: 0.8rem;
				color: var(--text-muted);
				font-family: var(--font-mono);
				letter-spacing: 0.02em;
			}

			.read-more {
				display: inline-flex;
				align-items: center;
				gap: 0.35rem;
				font-size: 0.85rem;
				color: var(--accent);
				font-weight: 500;
			}

			.read-more .arrow {
				transition: transform 0.18s ease;
			}

			.card:hover .read-more .arrow,
			.card:focus-within .read-more .arrow {
				transform: translateX(3px);
			}

			.empty {
				text-align: center;
				padding: 3rem 1rem;
				color: var(--text-muted);
				border: 1px dashed var(--border);
				border-radius: 8px;
			}

			@media (max-width: 540px) {
				.card-link {
					padding: 1.25rem 1.25rem 1rem 1.5rem;
				}
				.title {
					font-size: 1.2rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			{posts.length === 0 ? (
				<div class="empty">No posts yet.</div>
			) : (
				<ul class="posts">
					{posts.map((post) => (
						<li class="card">
							<a class="card-link" href={`/blog/${post.id}/`}>
								<h2 class="title">{post.data.title}</h2>
								<p class="excerpt">{post.excerpt}</p>
								<div class="footer-row">
									<span class="date">
										<FormattedDate date={post.data.pubDate} />
									</span>
									<span class="read-more">
										Read post
										<span class="arrow" aria-hidden="true">→</span>
									</span>
								</div>
							</a>
						</li>
					))}
				</ul>
			)}
		</main>
		<Footer />
	</body>
</html>
