---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import researchVisual from '../content/blog/mcp-security-server-features/diagrams/trust-boundaries.png';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getReadingTime } from '../lib/reading-time';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const featured = posts[0];
const featuredReadingTime = featured
	? getReadingTime(featured.body ?? '')
	: undefined;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="home-main">
			<section class="hero" id="about">
				<div class="hero-copy">
					<p class="eyebrow">Security architecture · Complex systems</p>
					<h1>I find where complex systems fail—and turn that into stronger security.</h1>
					<p class="hero-lede">
						I’m Taraka Vishnumolakala, a cybersecurity engineer working
						across application and API security, cloud infrastructure,
						agentic systems, threat modeling, and offensive security.
					</p>
					<p class="role">
						Sr. Cybersecurity Engineer, Security Architecture at
						<a
							href="https://www.workday.com"
							target="_blank"
							rel="noopener noreferrer">Workday, Inc ↗</a
						>
					</p>
					<div class="hero-actions">
						<a class="button button-primary" href="#research">
							Read selected research <span aria-hidden="true">→</span>
						</a>
						<a
							class="button button-secondary"
							href="https://github.com/taraka-vishnumolakala"
							target="_blank"
							rel="noopener noreferrer"
						>
							View GitHub <span aria-hidden="true">↗</span>
						</a>
					</div>
				</div>
				<aside class="profile-card" aria-label="About Taraka Vishnumolakala">
					<div class="portrait-frame">
						<div class="portrait-accent" aria-hidden="true"></div>
						<img
							src="/taraka.png"
							alt="Taraka Vishnumolakala"
							width="3099"
							height="3899"
							fetchpriority="high"
						/>
					</div>
					<div class="profile-note">
						<span>Current focus</span>
						<p>
							Application and API security, cloud infrastructure, agentic
							systems, and developer-centered security architecture.
						</p>
					</div>
				</aside>
			</section>

			<ul class="expertise-strip" aria-label="Areas of expertise">
				<li>
					<span>01</span>
					<strong>Application & API Security</strong>
					<p>Product attack surface, secure design, and defensive engineering.</p>
				</li>
				<li>
					<span>02</span>
					<strong>Cloud & Infrastructure</strong>
					<p>Hardening, identity, trust boundaries, and platform risk.</p>
				</li>
				<li>
					<span>03</span>
					<strong>Agentic Security</strong>
					<p>Agent identity, MCP, A2A, A2UI, and AI system controls.</p>
				</li>
				<li>
					<span>04</span>
					<strong>Threat Modeling & Culture</strong>
					<p>Offensive thinking, champions programs, and durable workflows.</p>
				</li>
			</ul>

			{featured && (
				<section class="research-section" id="research">
					<div class="section-intro">
						<div>
							<p class="eyebrow">Selected research</p>
							<h2>Security analysis built for practitioners.</h2>
						</div>
						<a class="section-link" href="/blog">
							View all writing <span aria-hidden="true">→</span>
						</a>
					</div>

					<article class="featured-research">
						<a
							class="research-visual"
							href={`/blog/${featured.id}/`}
							aria-label={`Read ${featured.data.title}`}
						>
							<Image
								src={researchVisual}
								alt="MCP trust boundaries across users, agents, servers, and upstream services"
								width={1000}
							/>
						</a>
						<div class="research-copy">
							<div class="research-meta">
								<span>{featured.data.series ?? 'Security research'}</span>
								<span><FormattedDate date={featured.data.pubDate} /></span>
								{featuredReadingTime && <span>{featuredReadingTime} min read</span>}
							</div>
							<h3>
								<a href={`/blog/${featured.id}/`}>{featured.data.title}</a>
							</h3>
							<p>{featured.data.description}</p>
							<div class="research-footer">
								<div class="research-tags">
									{featured.data.tags?.slice(0, 3).map((tag) => (
										<a class="tag" href={`/tags/${tag}/`}>{tag}</a>
									))}
								</div>
								<a class="read-link" href={`/blog/${featured.id}/`}>
									Read the field guide <span aria-hidden="true">→</span>
								</a>
							</div>
						</div>
					</article>
				</section>
			)}

			<section class="approach-section">
				<div class="approach-heading">
					<p class="eyebrow">How I work</p>
					<h2>Security that holds up in real engineering environments.</h2>
					<p>
						My software-engineering background shapes how I assess systems:
						start with the decisions teams make under pressure, then trace
						where those decisions can fail.
					</p>
				</div>
				<div class="approach-grid">
					<article>
						<span>01 / Understand the system</span>
						<h3>Find the actual trust boundaries.</h3>
						<p>
							I map identities, data flows, protocol behavior, and failure
							modes before reaching for a vulnerability checklist.
						</p>
					</article>
					<article>
						<span>02 / Translate the risk</span>
						<h3>Connect flaws to credible attack paths.</h3>
						<p>
							Threat modeling and offensive thinking turn abstract findings
							into decisions engineering and leadership can act on.
						</p>
					</article>
					<article>
						<span>03 / Make the fix durable</span>
						<h3>Build security into the workflow.</h3>
						<p>
							The strongest controls become part of design reviews,
							developer tooling, champions programs, and team feedback.
						</p>
					</article>
				</div>
			</section>

			<section class="connect-section">
				<div>
					<p class="eyebrow">Elsewhere</p>
					<h2>Follow the research and engineering work.</h2>
				</div>
				<div class="connect-links">
					<a
						href="https://github.com/taraka-vishnumolakala"
						target="_blank"
						rel="noopener noreferrer"
					>
						<span>Code and open-source work</span>
						<strong>GitHub ↗</strong>
					</a>
					<a
						href="https://www.linkedin.com/in/tvishnumolakala/"
						target="_blank"
						rel="noopener noreferrer"
					>
						<span>Professional profile</span>
						<strong>LinkedIn ↗</strong>
					</a>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.home-main {
		padding-top: 4.5rem;
		padding-bottom: 7rem;
	}

	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1.25fr) minmax(330px, 0.75fr);
		gap: clamp(3rem, 8vw, 7.5rem);
		align-items: center;
		min-height: calc(100vh - 10rem);
		padding-bottom: 5rem;
	}

	.hero-copy h1 {
		max-width: 820px;
		margin-bottom: 1.5rem;
	}

	.hero-lede {
		max-width: 700px;
		margin: 0 0 1.3rem;
		color: var(--text-secondary);
		font-size: clamp(1.08rem, 2vw, 1.32rem);
		line-height: 1.65;
	}

	.role {
		margin: 0 0 2rem;
		color: var(--text-muted);
		font-size: 0.92rem;
	}

	.role a {
		color: var(--accent-strong);
		font-weight: 600;
	}

	.role a:hover {
		color: var(--heading);
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.profile-card {
		position: relative;
		max-width: 410px;
		justify-self: end;
	}

	.portrait-frame {
		position: relative;
		padding: 0 0.9rem 0.9rem 0;
	}

	.portrait-frame img {
		position: relative;
		z-index: 2;
		display: block;
		width: 100%;
		aspect-ratio: 4 / 5;
		border: 1px solid rgba(17, 17, 17, 0.16);
		border-radius: 10px;
		object-fit: cover;
		box-shadow: var(--box-shadow);
	}

	.portrait-accent {
		position: absolute;
		z-index: 1;
		right: 0;
		bottom: 0;
		width: 72%;
		height: 74%;
		border-radius: 10px;
		background:
			linear-gradient(rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.08)),
			var(--accent);
	}

	.profile-note {
		position: relative;
		z-index: 3;
		max-width: 300px;
		margin: -2.6rem 0 0 -2.25rem;
		padding: 1.15rem 1.25rem;
		border: 1px solid var(--border);
		border-radius: 8px;
		background: rgba(255, 255, 255, 0.95);
		box-shadow: var(--box-shadow-soft);
	}

	.profile-note span {
		color: var(--accent-strong);
		font-family: var(--font-mono);
		font-size: 0.64rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.profile-note p {
		margin: 0.35rem 0 0;
		color: var(--text-secondary);
		font-size: 0.8rem;
		line-height: 1.55;
	}

	.expertise-strip {
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		border-top: 1px solid var(--border);
		border-bottom: 1px solid var(--border);
		list-style: none;
	}

	.expertise-strip li {
		min-height: 180px;
		padding: 1.75rem 1.5rem;
		border-right: 1px solid var(--border);
	}

	.expertise-strip li:first-child {
		padding-left: 0;
	}

	.expertise-strip li:last-child {
		padding-right: 0;
		border-right: 0;
	}

	.expertise-strip span {
		display: block;
		margin-bottom: 1.7rem;
		color: var(--accent);
		font-family: var(--font-mono);
		font-size: 0.66rem;
	}

	.expertise-strip strong {
		display: block;
		margin-bottom: 0.45rem;
		color: var(--heading);
		font-size: 0.95rem;
	}

	.expertise-strip p {
		margin: 0;
		color: var(--text-muted);
		font-size: 0.8rem;
		line-height: 1.55;
	}

	.research-section,
	.approach-section {
		padding: 7.5rem 0;
		border-bottom: 1px solid var(--border);
	}

	.section-intro {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 3rem;
		margin-bottom: 3rem;
	}

	.section-intro > div {
		max-width: 720px;
	}

	.section-link,
	.read-link {
		flex-shrink: 0;
		color: var(--accent-strong);
		font-size: 0.86rem;
		font-weight: 600;
	}

	.section-link:hover,
	.read-link:hover {
		color: var(--heading);
		transform: translateX(3px);
	}

	.featured-research {
		display: grid;
		grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
		border: 1px solid var(--border);
		border-radius: 14px;
		background: var(--bg-card);
		box-shadow: var(--box-shadow-soft);
		overflow: hidden;
	}

	.research-visual {
		position: relative;
		display: grid;
		place-items: center;
		min-height: 430px;
		padding: 2rem;
		border-right: 1px solid var(--border);
		background:
			linear-gradient(rgba(17, 17, 17, 0.06) 1px, transparent 1px),
			linear-gradient(90deg, rgba(17, 17, 17, 0.06) 1px, transparent 1px),
			var(--accent-faint);
		background-size: 28px 28px;
	}

	.research-visual::after {
		content: "";
		position: absolute;
		inset: 0;
		background: linear-gradient(145deg, transparent 45%, rgba(17, 17, 17, 0.08));
		pointer-events: none;
	}

	.research-visual img {
		position: relative;
		z-index: 1;
		width: 100%;
		border: 1px solid var(--border);
		border-radius: 8px;
		filter: grayscale(1);
		box-shadow: var(--box-shadow);
		transition: transform 0.25s ease;
	}

	.research-visual:hover img {
		transform: translateY(-4px);
	}

	.research-copy {
		display: flex;
		flex-direction: column;
		padding: clamp(2rem, 5vw, 4rem);
	}

	.research-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.7rem 1.25rem;
		margin-bottom: 1.6rem;
		color: var(--text-faint);
		font-family: var(--font-mono);
		font-size: 0.65rem;
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}

	.research-copy h3 {
		margin-bottom: 1rem;
		font-family: var(--font-display);
		font-size: clamp(2rem, 4vw, 3.15rem);
		letter-spacing: -0.025em;
		line-height: 1.1;
	}

	.research-copy h3 a:hover {
		color: var(--accent-strong);
	}

	.research-copy > p {
		max-width: 600px;
		margin: 0 0 2rem;
		color: var(--text-secondary);
		line-height: 1.72;
	}

	.research-footer {
		margin-top: auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.25rem;
	}

	.research-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
	}

	.research-tags a:hover {
		border-color: var(--accent);
		color: var(--accent-strong);
	}

	.approach-section {
		display: grid;
		grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
		gap: clamp(3rem, 8vw, 7rem);
	}

	.approach-heading h2 {
		margin-bottom: 1.3rem;
	}

	.approach-heading > p:last-child {
		max-width: 520px;
		margin: 0;
		color: var(--text-secondary);
		line-height: 1.75;
	}

	.approach-grid {
		border-top: 1px solid var(--border);
	}

	.approach-grid article {
		display: grid;
		grid-template-columns: 190px minmax(0, 1fr);
		gap: 1.75rem;
		padding: 1.9rem 0;
		border-bottom: 1px solid var(--border);
	}

	.approach-grid article > span {
		color: var(--accent-strong);
		font-family: var(--font-mono);
		font-size: 0.64rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.approach-grid h3 {
		margin-bottom: 0.5rem;
	}

	.approach-grid p {
		grid-column: 2;
		margin: -0.8rem 0 0;
		color: var(--text-muted);
		font-size: 0.86rem;
		line-height: 1.65;
	}

	.connect-section {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(320px, 0.8fr);
		gap: 5rem;
		align-items: end;
		padding-top: 7.5rem;
	}

	.connect-section h2 {
		max-width: 680px;
	}

	.connect-links {
		border-top: 1px solid var(--border);
	}

	.connect-links a {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		padding: 1.2rem 0;
		border-bottom: 1px solid var(--border);
	}

	.connect-links a:hover {
		padding-left: 0.4rem;
		color: var(--accent-strong);
	}

	.connect-links span {
		color: var(--text-muted);
		font-size: 0.78rem;
	}

	.connect-links strong {
		color: inherit;
		font-size: 0.9rem;
	}

	@media (max-width: 980px) {
		.hero {
			grid-template-columns: minmax(0, 1fr) minmax(280px, 0.62fr);
			gap: 3rem;
		}

		.expertise-strip {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.expertise-strip li:nth-child(2) {
			border-right: 0;
		}

		.expertise-strip li:nth-child(-n + 2) {
			border-bottom: 1px solid var(--border);
		}

		.expertise-strip li:nth-child(3) {
			padding-left: 0;
		}

		.featured-research,
		.approach-section,
		.connect-section {
			grid-template-columns: 1fr;
		}

		.research-visual {
			min-height: 360px;
			border-right: 0;
			border-bottom: 1px solid var(--border);
		}

		.connect-section {
			gap: 3rem;
		}
	}

	@media (max-width: 760px) {
		.home-main {
			padding-top: 3rem;
			padding-bottom: 5rem;
		}

		.hero {
			grid-template-columns: 1fr;
			min-height: 0;
			padding-bottom: 4.5rem;
		}

		.hero-copy h1 {
			font-size: clamp(2.85rem, 12vw, 3.6rem);
		}

		.profile-card {
			width: min(88%, 390px);
			justify-self: center;
		}

		.profile-note {
			margin-left: -1rem;
		}

		.expertise-strip {
			grid-template-columns: 1fr;
		}

		.expertise-strip li,
		.expertise-strip li:first-child,
		.expertise-strip li:nth-child(3) {
			min-height: 0;
			padding: 1.35rem 0;
			border-right: 0;
			border-bottom: 1px solid var(--border);
		}

		.expertise-strip li:last-child {
			border-bottom: 0;
		}

		.expertise-strip span {
			margin-bottom: 0.85rem;
		}

		.research-section,
		.approach-section {
			padding: 5.5rem 0;
		}

		.section-intro {
			align-items: flex-start;
			flex-direction: column;
			gap: 1.5rem;
		}

		.research-visual {
			min-height: 250px;
			padding: 1.25rem;
		}

		.research-copy {
			padding: 2rem 1.4rem;
		}

		.research-footer {
			align-items: flex-start;
			flex-direction: column;
		}

		.approach-section {
			gap: 3rem;
		}

		.approach-grid article {
			grid-template-columns: 1fr;
			gap: 0.6rem;
		}

		.approach-grid p {
			grid-column: 1;
			margin: 0;
		}

		.connect-section {
			padding-top: 5.5rem;
		}

		.connect-links a {
			align-items: flex-start;
			flex-direction: column;
			gap: 0.25rem;
		}
	}
</style>
