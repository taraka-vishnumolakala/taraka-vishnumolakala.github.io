		.gradient-controls,
		.activation-controls,
		.entropy-controls {
			grid-template-columns: 1fr;
			gap: 1rem;
		}

		canvas {
			height: 280px;
		}

		.metric-grid {
			grid-template-columns: 1fr;
		}
	}
