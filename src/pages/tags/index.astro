---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const posts = await getCollection('blog');

const tagCounts = new Map<string, number>();
for (const post of posts) {
	for (const tag of post.data.tags ?? []) {
		tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
	}
}

const tags = [...tagCounts.entries()].sort((a, b) => a[0].localeCompare(b[0]));
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Tags — ${SITE_TITLE}`} description="Browse posts by tag" />
		<style>
			main {
				max-width: 1400px;
			}
			.page-header {
				max-width: 720px;
				margin-bottom: 2rem;
			}
			.page-header h1 {
				margin: 0 0 0.75rem;
			}
			.page-header p {
				margin: 0;
				color: var(--text-secondary);
			}
			ul {
				list-style: none;
				margin: 0;
				padding: 0;
				display: flex;
				flex-wrap: wrap;
				gap: 0.75rem;
			}
			ul li a {
				display: inline-flex;
				align-items: center;
				gap: 0.4rem;
				padding: 0.35rem 0.9rem;
				border: 1px solid var(--border);
				border-radius: 999px;
				font-size: 0.78rem;
				color: var(--text);
				transition:
					border-color 0.15s ease,
					color 0.15s ease;
			}
			ul li a:hover {
				border-color: var(--heading);
				color: var(--heading);
			}
			.count {
				color: var(--text-muted);
				font-size: 0.7rem;
			}
			.empty {
				color: var(--text-muted);
				font-size: 1rem;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<header class="page-header">
				<h1>Topics</h1>
				<p>Browse writing by security and technology topic.</p>
			</header>
			{
				tags.length === 0 ? (
					<p class="empty">No tags yet.</p>
				) : (
					<ul>
						{tags.map(([tag, count]) => (
							<li>
								<a href={`/tags/${tag}/`}>
									{tag}
									<span class="count">{count}</span>
								</a>
							</li>
						))}
					</ul>
				)
			}
		</main>
		<Footer />
	</body>
</html>
