---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="home-main">
			<section class="hero" id="about">
				<div class="hero-copy">
					<p class="eyebrow">Software engineering · Security engineering</p>
					<h1>Software engineer turned security engineer.</h1>
					<p class="hero-lede">
						I’m Taraka Vishnumolakala. I currently focus on Agent and ML
						Security, with broader experience in security system design,
						application and API security, cloud security, threat modeling,
						and offensive security.
					</p>
					<p class="role">
						Sr. Cybersecurity Engineer, Security Architecture at
						<a
							href="https://www.workday.com"
							target="_blank"
							rel="noopener noreferrer">Workday, Inc ↗</a
						>
					</p>
					<div class="hero-actions">
						<a class="button button-primary" href="#experience">
							View experience <span aria-hidden="true">→</span>
						</a>
						<a
							class="button button-secondary"
							href="https://github.com/taraka-vishnumolakala"
							target="_blank"
							rel="noopener noreferrer"
						>
							View GitHub <span aria-hidden="true">↗</span>
						</a>
					</div>
				</div>
				<aside class="profile-card" aria-label="About Taraka Vishnumolakala">
					<div class="portrait-frame">
						<div class="portrait-accent" aria-hidden="true"></div>
						<img
							src="/taraka.png"
							alt="Taraka Vishnumolakala"
							width="3099"
							height="3899"
							fetchpriority="high"
						/>
					</div>
					<div class="profile-note">
						<span>Current focus</span>
						<p>
							Agent and ML Security, including agent identity, model
							lifecycle controls, system design, and secure integration.
						</p>
					</div>
				</aside>
			</section>

			<ul class="expertise-strip" aria-label="Areas of expertise">
				<li>
					<span>01</span>
					<strong>Agent & ML Security</strong>
					<p>ML model risks, agent identity, MCP, A2A, A2UI, and AI system controls.</p>
				</li>
				<li>
					<span>02</span>
					<strong>Application & API Security</strong>
					<p>Product attack surface, secure design, and defensive engineering.</p>
				</li>
				<li>
					<span>03</span>
					<strong>Cloud Security</strong>
					<p>Hardening, identity, trust boundaries, and platform risk.</p>
				</li>
				<li>
					<span>04</span>
					<strong>Threat Modeling & Culture</strong>
					<p>Offensive thinking, champions programs, and durable workflows.</p>
				</li>
			</ul>

			<section class="experience-section" id="experience">
				<div class="section-intro">
					<div>
						<p class="eyebrow">Experience</p>
						<h2>From software engineering to security architecture.</h2>
					</div>
					<p>
						Roles spanning security architecture, application security, and
						software engineering since 2018.
					</p>
				</div>

				<ol class="career-timeline" aria-label="Professional experience">
					<li class="timeline-item" data-timeline-item>
						<p class="timeline-period">Sep 2023 — Present</p>
						<span class="timeline-marker" aria-hidden="true"></span>
						<article class="timeline-entry">
							<p class="timeline-company">Workday, Inc.</p>
							<h3>Senior Cybersecurity Engineer, Security Architecture</h3>
							<p>
								Security architecture, threat modeling, and secure-design
								guidance across product, cloud, ML, and agentic systems.
							</p>
						</article>
					</li>
					<li class="timeline-item" data-timeline-item>
						<p class="timeline-period">Aug 2022 — Sep 2023</p>
						<span class="timeline-marker" aria-hidden="true"></span>
						<article class="timeline-entry">
							<p class="timeline-company">GoodLeap, LLC</p>
							<h3>Application Security Engineer</h3>
							<p>
								Application and API security, white-box testing, secure
								code review, cloud security, and Security Champions
								program leadership.
							</p>
						</article>
					</li>
					<li class="timeline-item" data-timeline-item>
						<p class="timeline-period">May 2021 — Aug 2022</p>
						<span class="timeline-marker" aria-hidden="true"></span>
						<article class="timeline-entry">
							<p class="timeline-company">Election Systems & Software</p>
							<h3>Application Security Engineer</h3>
							<p>
								Product security strategy, Secure SDLC, vulnerability
								management, security architecture, cryptography, and
								infrastructure hardening for voting systems.
							</p>
						</article>
					</li>
					<li class="timeline-item" data-timeline-item>
						<p class="timeline-period">Jan 2019 — May 2021</p>
						<span class="timeline-marker" aria-hidden="true"></span>
						<article class="timeline-entry">
							<p class="timeline-company">Election Systems & Software</p>
							<h3>Software Engineer, Security</h3>
							<p>
								Built and optimized mission-critical election software,
								data-processing workflows, and cryptographic integrations.
							</p>
						</article>
					</li>
					<li class="timeline-item" data-timeline-item>
						<p class="timeline-period">May 2018 — Dec 2018</p>
						<span class="timeline-marker" aria-hidden="true"></span>
						<article class="timeline-entry">
							<p class="timeline-company">Election Systems & Software</p>
							<h3>Software Engineer Intern</h3>
							<p>
								Developed Java applications and database-migration tooling
								for election systems.
							</p>
						</article>
					</li>
				</ol>
			</section>

			<section class="approach-section">
				<div class="approach-heading">
					<p class="eyebrow">How I work</p>
					<h2>A practical approach to security architecture.</h2>
					<p>
						I start with system context, identify credible failure paths, and
						work with engineering teams on controls that can be implemented
						and maintained.
					</p>
				</div>
				<div class="approach-grid">
					<article>
						<span>01 / Understand context</span>
						<h3>Map the system and its trust boundaries.</h3>
						<p>
							Review architecture, identities, data flows, dependencies,
							and operational constraints before assessing risk.
						</p>
					</article>
					<article>
						<span>02 / Assess risk</span>
						<h3>Prioritize credible attack paths.</h3>
						<p>
							Use threat modeling, code review, and offensive testing to
							connect design decisions to realistic impact.
						</p>
					</article>
					<article>
						<span>03 / Define controls</span>
						<h3>Turn findings into engineering decisions.</h3>
						<p>
							Recommend specific controls, owners, and verification steps,
							then integrate them into design reviews and development
							workflows.
						</p>
					</article>
				</div>
			</section>

			<section class="background-section">
				<div class="background-heading">
					<p class="eyebrow">Background</p>
					<h2>Education and conference speaking.</h2>
				</div>
				<div class="background-grid">
					<article>
						<span>Education</span>
						<div class="credential">
							<time datetime="2019">2019</time>
							<div>
								<h3>Master’s in Cybersecurity</h3>
								<p>University of Nebraska at Omaha</p>
							</div>
						</div>
						<div class="credential">
							<time datetime="2016">2016</time>
							<div>
								<h3>B.E. in Electronics and Communication</h3>
								<p>Andhra University</p>
							</div>
						</div>
					</article>
					<article>
						<span>Speaking</span>
						<div class="credential">
							<time datetime="2025">2025</time>
							<div>
								<h3>
									Threat Modeling as a Team Sport with Security Champions & AI
								</h3>
								<p>ThreatModCon · Conference speaker</p>
							</div>
						</div>
					</article>
				</div>
			</section>

			<section class="connect-section">
				<div>
					<p class="eyebrow">Elsewhere</p>
					<h2>Follow the research and engineering work.</h2>
				</div>
				<div class="connect-links">
					<a
						href="https://github.com/taraka-vishnumolakala"
						target="_blank"
						rel="noopener noreferrer"
					>
						<span>Code and open-source work</span>
						<strong>GitHub ↗</strong>
					</a>
					<a
						href="https://www.linkedin.com/in/tvishnumolakala/"
						target="_blank"
						rel="noopener noreferrer"
					>
						<span>Professional profile</span>
						<strong>LinkedIn ↗</strong>
					</a>
				</div>
			</section>
		</main>
		<Footer />
		<script>
			const timelineItems = Array.from(
				document.querySelectorAll<HTMLElement>('[data-timeline-item]'),
			);
			const reducedMotion = window.matchMedia(
				'(prefers-reduced-motion: reduce)',
			).matches;

			if ('IntersectionObserver' in window && !reducedMotion) {
				document.documentElement.classList.add('timeline-reveal-ready');
				const observer = new IntersectionObserver(
					(entries) => {
						entries.forEach((entry) => {
							if (!entry.isIntersecting) return;
							entry.target.classList.add('is-visible');
							observer.unobserve(entry.target);
						});
					},
					{ rootMargin: '0px 0px -12% 0px', threshold: 0.12 },
				);

				timelineItems.forEach((item) => observer.observe(item));
			} else {
				timelineItems.forEach((item) => item.classList.add('is-visible'));
			}
		</script>
	</body>
</html>

<style>
	.home-main {
		padding-top: 4.5rem;
		padding-bottom: 7rem;
	}

	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1.25fr) minmax(330px, 0.75fr);
		gap: clamp(3rem, 8vw, 7.5rem);
		align-items: center;
		min-height: calc(100vh - 10rem);
		padding-bottom: 5rem;
	}

	.hero-copy h1 {
		max-width: 820px;
		margin-bottom: 1.5rem;
		font-size: clamp(3rem, 4.5vw, 4.25rem);
	}

	.hero-lede {
		max-width: 700px;
		margin: 0 0 1.3rem;
		color: var(--text-secondary);
		font-size: clamp(1.08rem, 2vw, 1.32rem);
		line-height: 1.65;
	}

	.role {
		margin: 0 0 2rem;
		color: var(--text-muted);
		font-size: 0.92rem;
	}

	.role a {
		color: var(--accent-strong);
		font-weight: 600;
	}

	.role a:hover {
		color: var(--heading);
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.profile-card {
		position: relative;
		max-width: 410px;
		justify-self: end;
	}

	.portrait-frame {
		position: relative;
		padding: 0 0.9rem 0.9rem 0;
	}

	.portrait-frame img {
		position: relative;
		z-index: 2;
		display: block;
		width: 100%;
		aspect-ratio: 4 / 5;
		border: 1px solid rgba(17, 17, 17, 0.16);
		border-radius: 10px;
		object-fit: cover;
		box-shadow: var(--box-shadow);
	}

	.portrait-accent {
		position: absolute;
		z-index: 1;
		right: 0;
		bottom: 0;
		width: 72%;
		height: 74%;
		border-radius: 10px;
		background:
			linear-gradient(rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.08)),
			var(--accent);
	}

	.profile-note {
		position: relative;
		z-index: 3;
		max-width: 300px;
		margin: -2.6rem 0 0 -2.25rem;
		padding: 1.15rem 1.25rem;
		border: 1px solid var(--border);
		border-radius: 8px;
		background: rgba(255, 255, 255, 0.95);
		box-shadow: var(--box-shadow-soft);
	}

	.profile-note span {
		color: var(--accent-strong);
		font-family: var(--font-mono);
		font-size: 0.64rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.profile-note p {
		margin: 0.35rem 0 0;
		color: var(--text-secondary);
		font-size: 0.8rem;
		line-height: 1.55;
	}

	.expertise-strip {
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		border-top: 1px solid var(--border);
		border-bottom: 1px solid var(--border);
		list-style: none;
	}

	.expertise-strip li {
		min-height: 180px;
		padding: 1.75rem 1.5rem;
		border-right: 1px solid var(--border);
	}

	.expertise-strip li:first-child {
		padding-left: 0;
	}

	.expertise-strip li:last-child {
		padding-right: 0;
		border-right: 0;
	}

	.expertise-strip span {
		display: block;
		margin-bottom: 1.7rem;
		color: var(--accent);
		font-family: var(--font-mono);
		font-size: 0.66rem;
	}

	.expertise-strip strong {
		display: block;
		margin-bottom: 0.45rem;
		color: var(--heading);
		font-size: 0.95rem;
	}

	.expertise-strip p {
		margin: 0;
		color: var(--text-muted);
		font-size: 0.8rem;
		line-height: 1.55;
	}

	.experience-section,
	.approach-section {
		padding: 7.5rem 0;
		border-bottom: 1px solid var(--border);
	}

	.section-intro {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(320px, 0.55fr);
		align-items: end;
		gap: clamp(3rem, 8vw, 7rem);
		margin-bottom: 3.5rem;
	}

	.section-intro > div {
		max-width: 720px;
	}

	.section-intro > p {
		max-width: 520px;
		margin: 0;
		color: var(--text-secondary);
		line-height: 1.75;
	}

	.career-timeline {
		position: relative;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.career-timeline::before {
		content: "";
		position: absolute;
		top: 0.6rem;
		bottom: 0;
		left: 180px;
		width: 1px;
		background: var(--border);
	}

	.timeline-item {
		position: relative;
		display: grid;
		grid-template-columns: 160px 40px minmax(0, 1fr);
		align-items: start;
	}

	.timeline-period {
		margin: 0;
		padding-top: 0.1rem;
		color: var(--text-muted);
		font-family: var(--font-mono);
		font-size: 0.67rem;
		line-height: 1.5;
		text-align: right;
		text-transform: uppercase;
	}

	.timeline-marker {
		position: relative;
		z-index: 1;
		width: 11px;
		height: 11px;
		margin-top: 0.35rem;
		justify-self: center;
		border: 2px solid var(--bg-card);
		border-radius: 50%;
		background: var(--heading);
		box-shadow: 0 0 0 1px var(--heading);
	}

	.timeline-entry {
		margin-bottom: 3.25rem;
		padding: 0 0 3.25rem 1rem;
		border-bottom: 1px solid var(--border);
	}

	.timeline-item:last-child .timeline-entry {
		margin-bottom: 0;
	}

	.timeline-company {
		margin: 0 0 0.65rem;
		color: var(--accent-strong);
		font-family: var(--font-mono);
		font-size: 0.64rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.timeline-entry h3 {
		margin-bottom: 0.75rem;
		font-size: clamp(1.25rem, 2vw, 1.65rem);
	}

	.timeline-entry > p:last-child {
		max-width: 720px;
		margin: 0;
		color: var(--text-muted);
		font-size: 0.94rem;
		line-height: 1.7;
	}

	:global(html.timeline-reveal-ready) .timeline-item {
		opacity: 0;
		transform: translateY(24px);
		transition:
			opacity 0.55s ease,
			transform 0.55s ease;
	}

	:global(html.timeline-reveal-ready) .timeline-item.is-visible {
		opacity: 1;
		transform: translateY(0);
	}

	.approach-section {
		display: grid;
		grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
		gap: clamp(3rem, 8vw, 7rem);
	}

	.approach-heading h2 {
		margin-bottom: 1.3rem;
	}

	.approach-heading > p:last-child {
		max-width: 520px;
		margin: 0;
		color: var(--text-secondary);
		line-height: 1.75;
	}

	.approach-grid {
		border-top: 1px solid var(--border);
	}

	.approach-grid article {
		display: grid;
		grid-template-columns: 190px minmax(0, 1fr);
		gap: 1.75rem;
		padding: 1.9rem 0;
		border-bottom: 1px solid var(--border);
	}

	.approach-grid article > span {
		color: var(--accent-strong);
		font-family: var(--font-mono);
		font-size: 0.64rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.approach-grid h3 {
		margin-bottom: 0.5rem;
	}

	.approach-grid p {
		grid-column: 2;
		margin: -0.8rem 0 0;
		color: var(--text-muted);
		font-size: 0.86rem;
		line-height: 1.65;
	}

	.background-section {
		display: grid;
		grid-template-columns: minmax(0, 0.65fr) minmax(0, 1.35fr);
		gap: clamp(3rem, 8vw, 7rem);
		padding: 7.5rem 0;
		border-bottom: 1px solid var(--border);
	}

	.background-heading h2 {
		max-width: 520px;
	}

	.background-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		border-top: 1px solid var(--border);
		border-left: 1px solid var(--border);
	}

	.background-grid > article {
		padding: clamp(1.75rem, 3vw, 2.4rem);
		border-right: 1px solid var(--border);
		border-bottom: 1px solid var(--border);
		background: rgba(255, 255, 255, 0.76);
	}

	.background-grid > article > span {
		display: block;
		margin-bottom: 2rem;
		color: var(--accent-strong);
		font-family: var(--font-mono);
		font-size: 0.64rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.credential {
		display: grid;
		grid-template-columns: 46px minmax(0, 1fr);
		gap: 1rem;
		padding: 1.35rem 0;
		border-top: 1px solid var(--border-soft);
	}

	.credential:first-of-type {
		padding-top: 0;
		border-top: 0;
	}

	.credential time {
		color: var(--text-faint);
		font-family: var(--font-mono);
		font-size: 0.65rem;
	}

	.credential h3 {
		margin-bottom: 0.35rem;
		font-size: 1rem;
		line-height: 1.35;
	}

	.credential p {
		margin: 0;
		color: var(--text-muted);
		font-size: 0.8rem;
		line-height: 1.55;
	}

	.connect-section {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(320px, 0.8fr);
		gap: 5rem;
		align-items: end;
		padding-top: 7.5rem;
	}

	.connect-section h2 {
		max-width: 680px;
	}

	.connect-links {
		border-top: 1px solid var(--border);
	}

	.connect-links a {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		padding: 1.2rem 0;
		border-bottom: 1px solid var(--border);
	}

	.connect-links a:hover {
		padding-left: 0.4rem;
		color: var(--accent-strong);
	}

	.connect-links span {
		color: var(--text-muted);
		font-size: 0.78rem;
	}

	.connect-links strong {
		color: inherit;
		font-size: 0.9rem;
	}

	@media (max-width: 980px) {
		.hero {
			grid-template-columns: minmax(0, 1fr) minmax(280px, 0.62fr);
			gap: 3rem;
		}

		.expertise-strip {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.expertise-strip li:nth-child(2) {
			border-right: 0;
		}

		.expertise-strip li:nth-child(-n + 2) {
			border-bottom: 1px solid var(--border);
		}

		.expertise-strip li:nth-child(3) {
			padding-left: 0;
		}

		.approach-section,
		.background-section,
		.connect-section {
			grid-template-columns: 1fr;
		}

		.connect-section {
			gap: 3rem;
		}
	}

	@media (max-width: 760px) {
		.home-main {
			padding-top: 3rem;
			padding-bottom: 5rem;
		}

		.hero {
			grid-template-columns: 1fr;
			min-height: 0;
			padding-bottom: 4.5rem;
		}

		.hero-copy h1 {
			font-size: clamp(2.85rem, 12vw, 3.6rem);
		}

		.profile-card {
			width: min(88%, 390px);
			justify-self: center;
		}

		.profile-note {
			margin-left: -1rem;
		}

		.expertise-strip {
			grid-template-columns: 1fr;
		}

		.expertise-strip li,
		.expertise-strip li:first-child,
		.expertise-strip li:nth-child(3) {
			min-height: 0;
			padding: 1.35rem 0;
			border-right: 0;
			border-bottom: 1px solid var(--border);
		}

		.expertise-strip li:last-child {
			border-bottom: 0;
		}

