---
import { getKnowledgeCategory } from '../content/knowledge-taxonomy';
import type { KnowledgeNote } from '../lib/knowledge';
import FormattedDate from './FormattedDate.astro';

type Props = {
	note: KnowledgeNote;
};

const { note } = Astro.props;
const category = getKnowledgeCategory(note.data.category);
const date = note.data.updatedDate ?? note.data.pubDate;
---

<article class="knowledge-card">
	<div class="card-meta">
		<span>{category.label}</span>
		<span>Updated <FormattedDate date={date} /></span>
	</div>
	<h3>
		<a href={`/knowledge/${note.id}/`}>{note.data.title}</a>
	</h3>
	<p>{note.data.description}</p>
	<div class="card-footer">
		<div class="topic-list">
			{note.data.topics.slice(0, 3).map((topic) => <span>{topic}</span>)}
		</div>
		<a href={`/knowledge/${note.id}/`}>
			Open note <span aria-hidden="true">→</span>
		</a>
	</div>
</article>

<style>
	.knowledge-card {
		min-height: 280px;
		display: flex;
		flex-direction: column;
		padding: clamp(1.5rem, 3vw, 2.25rem);
		border: 1px solid var(--border);
		border-radius: 10px;
		background: rgba(255, 255, 255, 0.72);
	}

	.knowledge-card:hover {
		background: var(--bg-card);
		box-shadow: var(--box-shadow-soft);
		transform: translateY(-3px);
	}

	.card-meta {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.5rem 1rem;
		margin-bottom: 2rem;
		color: var(--text-faint);
		font-family: var(--font-mono);
		font-size: 0.61rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.card-meta span:first-child {
		color: var(--accent-strong);
	}

	.knowledge-card h3 {
		margin-bottom: 0.8rem;
		font-size: 1.35rem;
		line-height: 1.3;
	}

	.knowledge-card h3 a:hover {
		color: var(--accent-strong);
	}

	.knowledge-card > p {
		margin: 0 0 2rem;
		color: var(--text-secondary);
		font-size: 0.9rem;
		line-height: 1.7;
	}

	.card-footer {
		margin-top: auto;
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1rem;
	}

	.topic-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
	}

	.topic-list span {
		padding: 0.28rem 0.48rem;
		border: 1px solid var(--border);
		border-radius: 999px;
		color: var(--text-muted);
		font-family: var(--font-mono);
		font-size: 0.58rem;
		line-height: 1;
	}

	.card-footer > a {
		flex-shrink: 0;
		color: var(--accent-strong);
		font-size: 0.78rem;
		font-weight: 600;
	}

	.card-footer > a:hover {
		color: var(--heading);
		transform: translateX(3px);
	}
</style>
