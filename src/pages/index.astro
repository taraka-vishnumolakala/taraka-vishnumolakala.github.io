---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<div class="split">
				<div class="split-image">
					<img src="/taraka.png" alt="Taraka Vishnumolakala" />
				</div>
				<div class="split-content">
					<p class="job-title">Sr. Cybersecurity Engineer, Security Architecture · <a href="https://www.workday.com" target="_blank" rel="noopener noreferrer">Workday, Inc</a></p>
					<p>
						I started my career as a software engineer. That experience gave
						me a deep appreciation for the decisions developers make under
						pressure, along with the oversights those decisions can leave
						behind. It shaped how I approach security today. Rather than
						treating it as an external audit, I work as someone who
						understands where systems are most likely to fail and how those
						gaps translate into real attack surface.
					</p>
					<p>
						Today I specialize in application and API security, cloud
						infrastructure hardening, threat modeling, and offensive security,
						including pentesting and red teaming that feed actionable findings
						back into the engineering process. I also focus on AI and ML risk
						by assessing model attack surfaces and designing controls for
						systems whose behavior is inherently non-deterministic.
					</p>
					<p>
						I care about building security cultures that last. That means
						running security champions programs, embedding security awareness
						into engineering workflows, and empowering developers to own
						security as a natural part of how they build.
					</p>
					<p class="links">
						<a href="https://github.com/taraka-vishnumolakala" target="_blank" rel="noopener noreferrer">
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="#181717" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
							GitHub
						</a>
						<a href="https://www.linkedin.com/in/tvishnumolakala/" target="_blank" rel="noopener noreferrer">
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="#0A66C2" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.063 2.063 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
							LinkedIn
						</a>
					</p>
				</div>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	.split {
		display: flex;
		flex-wrap: nowrap;
		gap: 3.5rem;
		align-items: flex-start;
	}

	.split-image {
		flex: 0 0 38%;
	}

	.split-image img {
		width: 100%;
		height: auto;
		display: block;
		border-radius: 6px;
		object-fit: cover;
	}

	.split-content {
		flex: 1;
		padding-top: 0.25rem;
	}

	.job-title {
		font-size: 1.5rem;
		font-weight: 700;
		color: var(--text-muted);
		margin: 0 0 1.5rem !important;
		letter-spacing: 0.01em;
	}

	.split-content p {
		font-size: 1rem;
		line-height: 1.75;
		color: var(--text);
		margin: 0 0 1.25rem;
	}

	.split-content p:last-child {
		margin-bottom: 0;
	}

	.split-content a {
		color: var(--text);
		text-decoration: underline;
		text-underline-offset: 3px;
		text-decoration-color: var(--border);
		transition:
			color 0.15s ease,
			text-decoration-color 0.15s ease;
	}

	.split-content a:hover {
		color: var(--heading);
		text-decoration-color: var(--text-muted);
	}

	.links {
		display: flex;
		gap: 1.5rem;
		margin-top: 0.5rem;
	}

	.links a {
		display: inline-flex;
		align-items: flex-end;
		gap: 0.5rem;
		font-size: 1rem;
		line-height: 1;
		text-decoration: none !important;
		color: var(--text-muted) !important;
		transition: color 0.15s ease !important;
	}

	.links a svg {
		display: block;
		flex-shrink: 0;
	}

	.links a:hover {
		color: var(--heading) !important;
	}

	@media (max-width: 640px) {
		.split {
			flex-direction: column;
			gap: 2rem;
		}

		.split-image {
			flex: none;
			width: 60%;
			margin: 0 auto;
		}
	}
</style>
