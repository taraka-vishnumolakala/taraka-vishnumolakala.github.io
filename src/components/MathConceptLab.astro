	}

	.button-group,
	.preset-group {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		align-items: end;
	}

	.button-group button,
	.preset-group button {
		min-height: 38px;
		padding: 0.55rem 0.75rem;
		border: 1px solid var(--heading);
