---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import FormattedDate from '../components/FormattedDate.astro';
import PageTableOfContents from '../components/PageTableOfContents.astro';
import SiteLayout from './SiteLayout.astro';

type Props = CollectionEntry<'blog'>['data'] & {
	id: string;
	headings?: MarkdownHeading[];
	readingTime?: number;
};

const {
	id,
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	author,
	tags,
	series,
	headings = [],
	readingTime,
} = Astro.props;

const hasToc = headings.some((heading) => heading.depth === 2);
---

<SiteLayout title={title} description={description} image={heroImage}>
	<link
		slot="head"
		rel="alternate"
		type="text/markdown"
		href={`/blog/${id}.md`}
	/>
	<div slot="before-header" class="reading-progress" aria-hidden="true">
		<span></span>
	</div>
		<main>
			<article>
				{heroImage && (
					<div class="hero-image">
						<Image width={1100} height={550} src={heroImage} alt="" />
					</div>
				)}
				<div class={`layout ${hasToc ? '' : 'no-toc'}`}>
					{hasToc && (
						<PageTableOfContents headings={headings} />
					)}
					<div class="prose">
						<header class="post-header">
							<p class="breadcrumb">
								<a href="/blog">Writing</a>
								{tags?.[0] && (
									<>
										<span aria-hidden="true">/</span>
										<a href={`/tags/${tags[0]}/`}>{tags[0]}</a>
									</>
								)}
							</p>
							{series && <p class="series-label">{series}</p>}
							<h1 class="post-title">{title}</h1>
							<p class="post-dek">{description}</p>
							<div class="post-meta">
								<div class="meta-col">
									<span class="meta-label">Written by</span>
									<span class="meta-value">{author}</span>
								</div>
								<div class="meta-col">
									<span class="meta-label">Published</span>
									<span class="meta-value"><FormattedDate date={pubDate} /></span>
								</div>
								{updatedDate && (
									<div class="meta-col">
										<span class="meta-label">Last updated</span>
										<span class="meta-value">
											<FormattedDate date={updatedDate} />
										</span>
									</div>
								)}
								{readingTime && (
									<div class="meta-col">
										<span class="meta-label">Reading time</span>
										<span class="meta-value">{readingTime} min read</span>
									</div>
								)}
							</div>
						</header>
						<slot />
						<footer class="article-footer">
							<div>
								<span>{series ?? 'Security research'}</span>
								<strong>Continue exploring the field notes.</strong>
							</div>
							<div class="article-footer-links">
								<a href="/blog">All writing <span aria-hidden="true">→</span></a>
								<a href="/tags">Browse tags <span aria-hidden="true">→</span></a>
							</div>
						</footer>
					</div>
				</div>
			</article>
		</main>

		<script slot="body-end">
			const progressBar =
				document.querySelector('.reading-progress span');
			const updateProgress = () => {
				if (!progressBar) return;
				const scrollable =
					document.documentElement.scrollHeight - window.innerHeight;
				const progress =
					scrollable > 0
						? Math.min(1, Math.max(0, window.scrollY / scrollable))
						: 0;
				progressBar.style.transform = `scaleX(${progress})`;
			};
			updateProgress();
			document.addEventListener('scroll', updateProgress, { passive: true });
		</script>
</SiteLayout>

<style>
	.reading-progress {
		position: fixed;
		z-index: 110;
		top: 71px;
		right: 0;
		left: 0;
		height: 2px;
		background: transparent;
		pointer-events: none;
	}

	.reading-progress span {
		display: block;
		width: 100%;
		height: 100%;
		background: var(--accent);
		transform: scaleX(0);
		transform-origin: left;
		will-change: transform;
	}

	main {
		width: min(calc(100% - 3rem), 1440px);
		max-width: none;
		padding-top: 4.5rem;
		padding-bottom: 7rem;
	}

	.hero-image {
		width: 100%;
		margin-bottom: 3rem;
	}

	.hero-image img {
		display: block;
		margin: 0 auto;
		border: 1px solid var(--border);
		border-radius: 14px;
		box-shadow: var(--box-shadow-soft);
	}

	.layout {
		display: grid;
		grid-template-columns: 230px minmax(0, 900px) minmax(0, 1fr);
		gap: 3rem;
		align-items: start;
	}

	.layout.no-toc {
		grid-template-columns: minmax(0, 900px);
		justify-content: center;
	}

	.prose :global(h2),
	.prose :global(h3),
	.prose :global(h4) {
		scroll-margin-top: 7.5rem;
	}

	.post-header {
		margin-bottom: 3rem;
	}

	.breadcrumb {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 0 0 2rem;
		color: var(--text-muted);
		font-size: 0.78rem;
	}

	.breadcrumb a:hover {
		color: var(--accent-strong);
	}

	.series-label {
		display: inline-flex;
		margin: 0 0 1.1rem;
		padding: 0.35rem 0.62rem;
		border: 1px solid rgba(17, 17, 17, 0.25);
		border-radius: 999px;
		background: var(--accent-faint);
		color: var(--accent-strong);
		font-family: var(--font-mono);
		font-size: 0.64rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.post-title {
		margin: 0 0 1.4rem;
		font-size: var(--font-size-page-title);
		font-weight: 600;
		line-height: 1.04;
	}

	.post-dek {
		max-width: 720px;
		margin: 0 0 2.2rem;
		color: var(--text-secondary);
		font-size: 1.16rem;
		line-height: 1.65;
	}

	.post-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 1.5rem 2.75rem;
		padding: 1.35rem 0;
		border-top: 1px solid var(--border);
		border-bottom: 1px solid var(--border);
	}

	.meta-label {
		display: block;
		margin-bottom: 0.25rem;
		color: var(--text-faint);
		font-family: var(--font-mono);
		font-size: 0.61rem;
		letter-spacing: 0.07em;
		text-transform: uppercase;
	}

	.meta-value {
		color: var(--heading);
		font-size: 0.84rem;
		font-weight: 500;
	}

	.article-footer {
		margin-top: 5rem;
		padding: 2rem;
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 2rem;
		border: 1px solid var(--border);
		border-radius: 10px;
		background: var(--accent-faint);
	}

	.article-footer > div:first-child {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	.article-footer > div:first-child span {
		color: var(--accent-strong);
		font-family: var(--font-mono);
		font-size: 0.62rem;
		letter-spacing: 0.07em;
		text-transform: uppercase;
	}

	.article-footer strong {
		font-family: var(--font-display);
		font-size: 1.35rem;
	}

	.article-footer-links {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 0.4rem;
	}

	.article-footer-links a {
		color: var(--accent-strong);
		font-size: 0.8rem;
		font-weight: 600;
	}

	.article-footer-links a:hover {
		color: var(--heading);
		transform: translateX(3px);
	}

	@media (max-width: 1340px) {
		.layout {
			grid-template-columns: minmax(0, 900px);
			justify-content: center;
			gap: 2.5rem;
		}
	}

	@media (max-width: 760px) {
		.reading-progress {
			top: 63px;
		}

		main {
			width: min(calc(100% - 2rem), 900px);
			padding-top: 3rem;
			padding-bottom: 5rem;
		}

		.post-dek {
			font-size: 1.05rem;
		}

		.post-meta {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 1.25rem;
		}

		.article-footer {
			align-items: flex-start;
			flex-direction: column;
			padding: 1.5rem;
		}

		.article-footer-links {
			align-items: flex-start;
		}
	}
</style>
