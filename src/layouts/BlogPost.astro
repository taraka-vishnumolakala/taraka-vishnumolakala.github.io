---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'] & {
	id: string;
	headings?: MarkdownHeading[];
	readingTime?: number;
};

type TocSection = {
	slug: string;
	text: string;
	children: { slug: string; text: string }[];
};

const {
	id,
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	author,
	tags,
	series,
	headings = [],
	readingTime,
} = Astro.props;

const tocSections: TocSection[] = [];
let currentSection: TocSection | null = null;
for (const heading of headings) {
	if (heading.depth === 2) {
		currentSection = { slug: heading.slug, text: heading.text, children: [] };
		tocSections.push(currentSection);
	} else if (heading.depth === 3 && currentSection) {
		currentSection.children.push({
			slug: heading.slug,
			text: heading.text,
		});
	}
}
const hasToc = tocSections.length > 0;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={heroImage} />
		<link rel="alternate" type="text/markdown" href={`/blog/${id}.md`} />
	</head>

	<body>
		<div class="reading-progress" aria-hidden="true"><span></span></div>
		<Header />
		<main>
			<article>
				{heroImage && (
					<div class="hero-image">
						<Image width={1100} height={550} src={heroImage} alt="" />
					</div>
				)}
				<div class={`layout ${hasToc ? '' : 'no-toc'}`}>
					{hasToc && (
						<aside class="toc" aria-label="Table of contents">
							<details class="toc-details" data-responsive-toc open>
								<summary>On this page</summary>
								<p class="toc-label">On this page</p>
								<ul class="toc-list">
									{tocSections.map((section) => (
										<li class="toc-section" data-toc-section={section.slug}>
											<a
												href={`#${section.slug}`}
												data-toc-link={section.slug}
											>
												{section.text}
											</a>
											{section.children.length > 0 && (
												<ul class="toc-children">
													{section.children.map((child) => (
														<li>
															<a
																href={`#${child.slug}`}
																data-toc-link={child.slug}
															>
																{child.text}
															</a>
														</li>
													))}
												</ul>
											)}
										</li>
									))}
								</ul>
							</details>
						</aside>
					)}
					<div class="prose">
						<header class="post-header">
							<p class="breadcrumb">
								<a href="/blog">Writing</a>
								{tags?.[0] && (
									<>
										<span aria-hidden="true">/</span>
										<a href={`/tags/${tags[0]}/`}>{tags[0]}</a>
									</>
								)}
							</p>
							{series && <p class="series-label">{series}</p>}
							<h1 class="post-title">{title}</h1>
							<p class="post-dek">{description}</p>
							<div class="post-meta">
								<div class="meta-col">
									<span class="meta-label">Written by</span>
									<span class="meta-value">{author}</span>
								</div>
								<div class="meta-col">
									<span class="meta-label">Published</span>
									<span class="meta-value"><FormattedDate date={pubDate} /></span>
								</div>
								{updatedDate && (
									<div class="meta-col">
										<span class="meta-label">Last updated</span>
										<span class="meta-value">
											<FormattedDate date={updatedDate} />
										</span>
									</div>
								)}
								{readingTime && (
									<div class="meta-col">
										<span class="meta-label">Reading time</span>
										<span class="meta-value">{readingTime} min read</span>
									</div>
								)}
							</div>
						</header>
						<slot />
						<footer class="article-footer">
							<div>
								<span>{series ?? 'Security research'}</span>
								<strong>Continue exploring the field notes.</strong>
							</div>
							<div class="article-footer-links">
								<a href="/blog">All writing <span aria-hidden="true">→</span></a>
								<a href="/tags">Browse topics <span aria-hidden="true">→</span></a>
							</div>
						</footer>
					</div>
				</div>
			</article>
		</main>
		<Footer />

		<script>
			const responsiveToc =
				document.querySelector<HTMLDetailsElement>('[data-responsive-toc]');
			const compactLayout = window.matchMedia('(max-width: 1020px)');
			if (responsiveToc && compactLayout.matches) {
				responsiveToc.removeAttribute('open');
			}

			const progressBar =
				document.querySelector<HTMLElement>('.reading-progress span');
			const updateProgress = () => {
				if (!progressBar) return;
				const scrollable =
					document.documentElement.scrollHeight - window.innerHeight;
				const progress =
					scrollable > 0
						? Math.min(1, Math.max(0, window.scrollY / scrollable))
						: 0;
				progressBar.style.transform = `scaleX(${progress})`;
			};
			updateProgress();
			document.addEventListener('scroll', updateProgress, { passive: true });

			const links =
				document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]');
			if (links.length > 0) {
				const linkBySlug = new Map<string, HTMLAnchorElement>();
				const sectionBySlug = new Map<string, HTMLElement>();
				const allSections = Array.from(
					document.querySelectorAll<HTMLElement>('[data-toc-section]'),
				);

				links.forEach((link) => {
					const slug = link.dataset.tocLink;
					if (!slug) return;
					linkBySlug.set(slug, link);
					const section = link.closest<HTMLElement>('[data-toc-section]');
					if (section) sectionBySlug.set(slug, section);
				});

				const articleHeadings = Array.from(linkBySlug.keys())
					.map((slug) => document.getElementById(slug))
					.filter((element): element is HTMLElement => element !== null);

				let activeSlug: string | null = null;
				const setActive = (slug: string | null) => {
					if (slug === activeSlug) return;
					if (activeSlug) {
						linkBySlug.get(activeSlug)?.classList.remove('active');
					}
					if (slug) linkBySlug.get(slug)?.classList.add('active');
					activeSlug = slug;

					const activeSection = slug ? sectionBySlug.get(slug) : null;
					allSections.forEach((section) => {
						section.classList.toggle('expanded', section === activeSection);
					});
				};

				const observer = new IntersectionObserver(
					(entries) => {
						const visible = entries
							.filter((entry) => entry.isIntersecting)
							.sort(
								(a, b) =>
									a.boundingClientRect.top - b.boundingClientRect.top,
							);

						if (visible.length > 0) {
							setActive(visible[0].target.id);
							return;
						}

						const above = articleHeadings.filter(
							(heading) => heading.getBoundingClientRect().top < 110,
						);
						if (above.length > 0) {
							setActive(above[above.length - 1].id);
						}
					},
					{ rootMargin: '-110px 0px -70% 0px', threshold: 0 },
				);

				articleHeadings.forEach((heading) => observer.observe(heading));
			}
		</script>
	</body>
</html>

<style>
	.reading-progress {
		position: fixed;
		z-index: 110;
		top: 71px;
		right: 0;
		left: 0;
		height: 2px;
		background: transparent;
		pointer-events: none;
	}

	.reading-progress span {
		display: block;
		width: 100%;
		height: 100%;
		background: var(--accent);
		transform: scaleX(0);
		transform-origin: left;
		will-change: transform;
	}

	main {
		max-width: 1280px;
		padding-top: 4.5rem;
		padding-bottom: 7rem;
	}

	.hero-image {
		width: 100%;
		margin-bottom: 3rem;
	}

	.hero-image img {
		display: block;
		margin: 0 auto;
		border: 1px solid var(--border);
		border-radius: 14px;
		box-shadow: var(--box-shadow-soft);
	}

	.layout {
		display: grid;
		grid-template-columns: 230px minmax(0, 780px) minmax(0, 1fr);
		gap: 3rem;
		align-items: start;
	}

	.layout.no-toc {
		grid-template-columns: minmax(0, 780px);
		justify-content: center;
	}

	.toc {
		position: sticky;
		top: 7.5rem;
		width: 230px;
		max-height: calc(100vh - 9rem);
		overflow-y: auto;
		scrollbar-width: thin;
	}

	.toc-label {
		margin: 0 0 0.9rem 1.25rem;
		color: var(--accent-strong);
		font-family: var(--font-mono);
		font-size: 0.64rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.toc-details > summary {
		display: none;
	}

	.toc ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.toc a {
		display: flex;
		align-items: flex-start;
		gap: 0.65rem;
		padding: 0.38rem 0;
		color: var(--text-muted);
		font-size: 0.75rem;
		line-height: 1.45;
	}

	.toc a::before {
		content: "";
		width: 8px;
		height: 1px;
		margin-top: 0.55rem;
		flex-shrink: 0;
		background: var(--border);
		transition:
			width 0.15s ease,
			background 0.15s ease;
	}

	.toc a:hover,
	.toc a.active {
		color: var(--heading);
	}

	.toc a.active {
		font-weight: 600;
	}

	.toc a.active::before {
		width: 16px;
		background: var(--accent);
	}

	.toc-children {
		max-height: 0;
		opacity: 0;
		overflow: hidden;
		transition:
			max-height 0.3s ease,
			opacity 0.2s ease;
	}

	.toc-section.expanded > .toc-children {
		max-height: 2000px;
		opacity: 1;
	}

	.toc-children a {
		padding-left: 1rem;
		color: var(--text-faint);
		font-size: 0.71rem;
	}

	.toc-children a.active::before {
		width: 10px;
	}

	.prose :global(h2),
	.prose :global(h3),
	.prose :global(h4) {
		scroll-margin-top: 7.5rem;
	}

	.post-header {
		margin-bottom: 3rem;
	}

	.breadcrumb {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 0 0 2rem;
		color: var(--text-muted);
		font-size: 0.78rem;
	}

	.breadcrumb a:hover {
		color: var(--accent-strong);
	}

	.series-label {
		display: inline-flex;
		margin: 0 0 1.1rem;
		padding: 0.35rem 0.62rem;
		border: 1px solid rgba(15, 113, 117, 0.25);
		border-radius: 999px;
		background: var(--accent-faint);
		color: var(--accent-strong);
		font-family: var(--font-mono);
		font-size: 0.64rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.post-title {
		margin: 0 0 1.4rem;
		font-size: clamp(3rem, 6vw, 5rem);
		font-weight: 600;
		line-height: 1;
	}

	.post-dek {
		max-width: 720px;
		margin: 0 0 2.2rem;
		color: var(--text-secondary);
		font-size: 1.16rem;
		line-height: 1.65;
	}

	.post-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 1.5rem 2.75rem;
		padding: 1.35rem 0;
		border-top: 1px solid var(--border);
		border-bottom: 1px solid var(--border);
	}

	.meta-label {
		display: block;
		margin-bottom: 0.25rem;
		color: var(--text-faint);
		font-family: var(--font-mono);
		font-size: 0.61rem;
		letter-spacing: 0.07em;
		text-transform: uppercase;
	}

	.meta-value {
		color: var(--heading);
		font-size: 0.84rem;
		font-weight: 500;
	}

	.article-footer {
		margin-top: 5rem;
		padding: 2rem;
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 2rem;
		border: 1px solid var(--border);
		border-radius: 10px;
		background: var(--accent-faint);
	}

	.article-footer > div:first-child {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	.article-footer > div:first-child span {
		color: var(--accent-strong);
		font-family: var(--font-mono);
		font-size: 0.62rem;
		letter-spacing: 0.07em;
		text-transform: uppercase;
	}

	.article-footer strong {
		font-family: var(--font-display);
		font-size: 1.35rem;
	}

	.article-footer-links {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 0.4rem;
	}

	.article-footer-links a {
		color: var(--accent-strong);
		font-size: 0.8rem;
		font-weight: 600;
	}

	.article-footer-links a:hover {
		color: var(--heading);
		transform: translateX(3px);
	}

	@media (max-width: 1020px) {
		.layout {
			grid-template-columns: minmax(0, 780px);
			justify-content: center;
			gap: 0;
		}

		.toc {
			position: relative;
			top: 0;
			width: auto;
			max-height: none;
			margin-bottom: 2.5rem;
			padding: 0.85rem 1rem;
			border: 1px solid var(--border);
			border-radius: 8px;
			background: var(--accent-faint);
			overflow: visible;
		}

		.toc-details > summary {
			display: flex;
			align-items: center;
			gap: 0.55rem;
			padding: 0.2rem 0;
			color: var(--accent-strong);
			font-family: var(--font-mono);
			font-size: 0.66rem;
			font-weight: 600;
			letter-spacing: 0.08em;
			list-style: none;
			text-transform: uppercase;
			cursor: pointer;
		}

		.toc-details > summary::-webkit-details-marker {
			display: none;
		}

		.toc-details > summary::before {
			content: "+";
			font-size: 1rem;
			line-height: 1;
		}

		.toc-details[open] > summary::before {
			content: "−";
		}

		.toc-label {
			display: none;
		}

		.toc-list {
			margin-top: 0.8rem !important;
			padding-top: 0.65rem !important;
			border-top: 1px solid var(--border);
		}

		.toc-children {
			max-height: 2000px;
			opacity: 1;
		}
	}

	@media (max-width: 760px) {
		.reading-progress {
			top: 63px;
		}

		main {
			padding-top: 3rem;
			padding-bottom: 5rem;
		}

		.post-title {
			font-size: clamp(2.8rem, 14vw, 4.2rem);
		}

		.post-dek {
			font-size: 1.05rem;
		}

		.post-meta {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 1.25rem;
		}

		.article-footer {
			align-items: flex-start;
			flex-direction: column;
			padding: 1.5rem;
		}

		.article-footer-links {
			align-items: flex-start;
		}
	}
</style>
